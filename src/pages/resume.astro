---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';

const experience = [
	{
		role: 'Senior UI/UX Designer',
		company: 'Global Rescue LLC',
		period: 'Mar 2025 - Present',
		summary: "Led continued evolution of GRID's UX architecture across enterprise web and consumer mobile platforms.",
		bullets: [
			'Enhanced multi-module dashboard scalability and cross-platform consistency',
			'Refined data-heavy user flows to improve clarity, speed, and decision-making',
			'Partnered with AI and product teams to integrate intelligent, adaptive user experiences',
		],
	},
	{
		role: 'Senior Product Designer',
		company: 'Solar Informatics Inc.',
		period: 'Feb 2022 - Mar 2025',
		summary: 'Led UX architecture for SolarAMPs ERP and enterprise renewable energy systems.',
		bullets: [
			'Owned multi-module UX architecture across operational workflows',
			'Contributed to product roadmap and platform evolution',
			'Governed scalable design standards across modules',
			'Led ERP architecture redesign across web & mobile',
			'Established scalable design system foundations',
		],
	},
	{
		role: 'Senior UI/UX Designer',
		company: 'Global Rescue LLC',
		period: 'Jul 2021 - Feb 2022',
		summary: 'Led full-platform UX architecture revamp of GRID, a mission-critical intelligence SaaS platform.',
		bullets: [
			'Re-structured multi-module dashboard ecosystem',
			'Improved usability in data-intensive environments',
			'Collaborated with AI teams on intelligent workflow integration',
		],
	},
	{
		role: 'UI/UX Design Lead',
		company: 'Vintage Technologies',
		period: 'Nov 2020 - Jul 2021',
		summary: 'Short-term leadership engagement overseeing UX direction.',
		bullets: [],
	},
	{
		role: 'Design Team Lead',
		company: 'Bitsol Technologies',
		period: 'May 2018 - Oct 2020',
		summary: 'Led enterprise client product design initiatives.',
		bullets: [
			'Drove discovery-to-delivery UX execution',
			'Shaped product direction across web-based platforms',
			'Translated business requirements into scalable interaction models',
		],
	},
	{
		role: 'Design Team Lead',
		company: 'Ninesol Technologies',
		period: 'Jul 2013 - Apr 2018',
		summary: 'Led and mentored a team of designers across multiple projects.',
		bullets: ['Standardized design processes and collaboration workflows', 'Delivered scalable client-facing platforms'],
	},
];

const tools = [
	'Figma',
	'Balsamiq',
	'Adobe Creative Suite',
	'Sketch',
	'Microsoft Teams',
	'Trello',
	'Slack',
	'ChatGPT',
];
---

<Layout
	title="Resume | Hassan Mujtaba, Product Designer & UX Architect"
	description="Resume of Muhammad Hassan Mujtaba — 12+ years of experience designing enterprise SaaS, AI-integrated systems, and complex product architecture."
>
	<a class="skip-link" href="#main-content">Skip to content</a>

	<div class="page">
		<SiteHeader />

		<main id="main-content">
			<section class="hero">
				<p class="eyebrow">Resume</p>
				<h1 class="display-title">12+ years designing enterprise SaaS, AI-integrated systems, and complex product architecture.</h1>
				<div class="hero-subgrid">
					<p class="hero-text">
						My work has focused on structuring multi-module SaaS systems that scale with
						operational complexity — across enterprise intelligence, renewable energy ERP, and
						healthcare platforms.
					</p>
				</div>
			</section>

			<section class="editorial-section">
				<div class="section-rail">
					<p class="section-kicker">Snapshot</p>
				</div>
				<div class="story-block">
					<p><strong class="snapshot-label">Role:</strong> Senior Product Designer / UX Architect</p>
					<p><strong class="snapshot-label">Specialties:</strong> AI-integrated systems, enterprise SaaS, intelligence platforms, healthcare systems, renewable energy</p>
					<p><strong class="snapshot-label">Contact:</strong> <a href="mailto:hassan.mujtaba715@gmail.com">hassan.mujtaba715@gmail.com</a> · <a href="tel:+923325662228">+92 332 5662228</a></p>
					<p><strong class="snapshot-label">LinkedIn:</strong> <a href="https://www.linkedin.com/in/hassanmujtaba/" target="_blank" rel="noopener">linkedin.com/in/hassanmujtaba</a></p>
				</div>
			</section>

			<section class="editorial-section">
				<div class="section-rail">
					<p class="section-kicker">Experience</p>
				</div>
				<div class="story-block">
					{
						experience.map((job) => (
							<div class="job-entry">
								<p>
									<strong class="job-role">{job.role}</strong> · {job.company}
									<br />
									<span class="job-period">{job.period}</span>
								</p>
								<p>{job.summary}</p>
								{job.bullets.length > 0 && (
									<ul class="job-bullets">
										{job.bullets.map((bullet) => (
											<li>{bullet}</li>
										))}
									</ul>
								)}
							</div>
						))
					}
				</div>
			</section>

			<section class="editorial-section">
				<div class="section-rail">
					<p class="section-kicker">Education</p>
				</div>
				<div class="story-block">
					<p>
						<strong>(MS) Project Management</strong><br />
						Bahria University, Islamabad · 2016 - 2018
					</p>
					<p>
						<strong>Bachelor of Software Engineering</strong><br />
						Bahria University, Islamabad · 2009 - 2013
					</p>
				</div>
			</section>

			<section class="editorial-section">
				<div class="section-rail">
					<p class="section-kicker">Recognition</p>
				</div>
				<div class="story-block">
					<p>
						<strong>Guest Speaker</strong> — Interaction Design Foundation, Islamabad Chapter · Dec 2025
					</p>
					<p>Conducted a session with fellow designers on "How AI is Reshaping the Designer's Workflow."</p>
				</div>
			</section>

			<section class="editorial-section">
				<div class="section-rail">
					<p class="section-kicker">Capabilities</p>
				</div>
				<div class="story-block">
					<ul class="job-bullets">
						<li><strong>AI-Integrated Product Systems</strong> — intelligent workflows, human-in-the-loop</li>
						<li><strong>Business-Aligned Architecture</strong> — multi-module SaaS systems that scale</li>
						<li><strong>Cross-Functional Influence</strong> — constraints turned into interaction models</li>
					</ul>
				</div>
			</section>

			<section class="editorial-section">
				<div class="section-rail">
					<p class="section-kicker">Tools</p>
				</div>
				<div class="story-block">
					<p>{tools.join(' · ')}</p>
				</div>
			</section>
		</main>
	</div>
</Layout>

<style>
	.page {
		position: relative;
		width: min(calc(100% - 3rem), 78rem);
		margin: 0 auto;
		padding: 1.25rem 0 5rem;
	}

	.eyebrow,
	.section-kicker {
		font-family: var(--font-mono);
		font-size: 0.82rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		line-height: 1.4;
		text-transform: uppercase;
	}

	.hero {
		padding: 6rem 0 4rem;
	}

	.eyebrow,
	.section-kicker {
		margin: 0;
		color: var(--muted-foreground);
		font-style: normal;
	}

	.hero-subgrid {
		display: grid;
		grid-template-columns: 1fr;
		margin-top: 1.75rem;
	}

	.hero-text,
	.story-block p {
		font-size: 1.08rem;
		line-height: 1.7;
		margin: 0;
	}

	.editorial-section {
		display: grid;
		grid-template-columns: 16rem minmax(0, 1fr);
		gap: 2rem;
		padding: 2.5rem 0;
		border-top: 1px solid var(--border);
	}

	.section-rail {
		align-self: start;
	}

	.story-block {
		display: grid;
		gap: 1rem;
		max-width: 52rem;
	}

	.story-block strong {
		color: var(--foreground);
	}

	.snapshot-label {
		color: #3b82f6;
	}

	.job-role {
		color: #8b5cf6;
	}

	.job-entry {
		display: grid;
		gap: 0.5rem;
		padding-bottom: 1.25rem;
		margin-bottom: 1.25rem;
		border-bottom: 1px solid var(--border);
	}

	.job-entry:last-child {
		padding-bottom: 0;
		margin-bottom: 0;
		border-bottom: 0;
	}

	.job-period {
		color: var(--muted-foreground);
		font-size: 0.95rem;
	}

	.job-bullets {
		margin: 0.25rem 0 0;
		padding-left: 1.25rem;
		list-style: disc;
		display: grid;
		gap: 0.35rem;
	}

	.job-bullets li {
		font-size: 1.02rem;
		line-height: 1.6;
	}

	@media (max-width: 980px) {
		.hero-subgrid {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 720px) {
		.page {
			width: min(calc(100% - 1.5rem), 78rem);
			padding-top: 1rem;
		}

		.hero {
			padding: 4rem 0 3rem;
		}

		.editorial-section {
			grid-template-columns: 1fr;
		}

		.hero-text,
		.story-block p {
			font-size: 1.05rem;
		}

		.tools-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
