---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
---

<Layout
	title="Terms of Use | Hassan Mujtaba"
	description="Terms of use for hxnmujtaba.com."
	showFooterCta={false}
	noindex={true}
>
	<a class="skip-link" href="#main-content">Skip to content</a>

	<div class="legal-page">
		<SiteHeader />

		<main id="main-content" class="legal-main">
			<header class="legal-header">
				<h1>Terms</h1>
				<p class="legal-intro">
					These terms govern use of this website. By browsing hxnmujtaba.com, you agree to the
					terms below, including how case-study work shown here is owned and may be used.
				</p>
				<p class="legal-updated">Last updated: September 29, 2026</p>
			</header>

			<article class="legal-content">
				<section>
					<h2>General Use</h2>
					<p>
						This website is a personal portfolio for Hassan Mujtaba, Product Designer & UX
						Architect. Its content is provided for general information, professional presentation,
						and contact purposes. Reasonable effort is made to keep it accurate and current, but no
						guarantee is made that every detail is complete or up to date.
					</p>
				</section>

				<section>
					<h2>Ownership of Case Study Work</h2>
					<p>
						Every product, platform, and case study featured on this site — including GRID,
						SolarAMPs, Medicra365, OfferLanded, SOAPsuds, Jot.ai, Unwynd, and Boxtr — was designed
						while working for or with the respective company, client, or employer.
						<strong>
							All rights to these products, their brands, trademarks, logos, source code, business
							logic, and underlying data belong to their respective clients and owners.
						</strong>
					</p>
					<p>
						Screenshots, mockups, and descriptions of this work are shown here solely to
						demonstrate design process, role, and professional experience. Nothing on this site
						should be read as a claim of ownership over, or an official release by, any company or
						product referenced. Live product links (such as soapsuds.io) belong to and are operated
						independently by their respective owners.
					</p>
					<p>
						If you are a rights holder and would like content involving your product removed or
						amended, contact
						<a href="mailto:hassan.mujtaba715@gmail.com">hassan.mujtaba715@gmail.com</a>
						and it will be addressed promptly.
					</p>
				</section>

				<section>
					<h2>Site Content</h2>
					<p>
						Apart from the third-party work described above, the portfolio's own writing, layout,
						and presentation are the property of Hassan Mujtaba and may not be reproduced or reused
						without permission.
					</p>
				</section>

				<section>
					<h2>External Links</h2>
					<p>
						This website may include links to third-party sites or services, including live
						products referenced in case studies. Those destinations operate independently and are
						governed by their own terms and policies.
					</p>
				</section>

				<section>
					<h2>No Warranty</h2>
					<p>
						This site and its content are provided "as is," without warranties of any kind. Use of
						this site is at your own discretion and risk.
					</p>
				</section>

				<section>
					<h2>Changes to These Terms</h2>
					<p>
						These terms may be updated from time to time. Continued use of the site after a change
						constitutes acceptance of the updated terms.
					</p>
				</section>

				<section>
					<h2>Contact</h2>
					<p>
						Questions about these terms can be directed to
						<a href="mailto:hassan.mujtaba715@gmail.com">hassan.mujtaba715@gmail.com</a>.
					</p>
				</section>
			</article>
		</main>
	</div>
</Layout>

<style>
	.legal-page {
		width: min(calc(100% - 3rem), 62rem);
		margin: 0 auto;
		padding: 1.25rem 0 5rem;
	}

	.legal-main {
		padding: 5rem 0 0;
	}

	.legal-header {
		max-width: 46rem;
	}

	.legal-updated {
		margin: 0;
		font-size: 0.95rem;
		line-height: 1.6;
		color: var(--muted-foreground);
	}

	.legal-updated {
		margin-top: 1.25rem;
	}

	h1 {
		margin: 0;
		font-size: clamp(2.5rem, 4.2vw, 3.9rem);
		line-height: 1.05;
		letter-spacing: -0.05em;
		font-weight: 800;
	}

	.legal-intro,
	.legal-content p {
		font-size: 1.05rem;
		line-height: 1.75;
	}

	.legal-intro {
		margin: 1.5rem 0 0;
		color: var(--muted-foreground);
	}

	.legal-content {
		margin-top: 3rem;
		padding-top: 2rem;
		border-top: 1px solid var(--border);
	}

	.legal-content section + section {
		margin-top: 2.5rem;
	}

	h2 {
		margin: 0 0 0.85rem;
		font-size: 1.35rem;
		line-height: 1.2;
		letter-spacing: -0.03em;
	}

	.legal-content p {
		margin: 0;
		max-width: 46rem;
	}

	.legal-content p + p {
		margin-top: 1rem;
	}

	.legal-content a {
		color: inherit;
		font-weight: 700;
	}

	@media (max-width: 720px) {
		.legal-page {
			width: min(calc(100% - 2.5rem), 62rem);
			padding-top: 1rem;
		}

		.legal-main {
			padding-top: 4rem;
		}
	}
</style>
