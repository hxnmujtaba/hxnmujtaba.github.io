---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
---

<Layout
	title="Privacy Policy | Hassan Mujtaba"
	description="Privacy policy for hxnmujtaba.com."
	showFooterCta={false}
	noindex={true}
>
	<a class="skip-link" href="#main-content">Skip to content</a>

	<div class="legal-page">
		<SiteHeader />

		<main id="main-content" class="legal-main">
			<header class="legal-header">
				<h1>Privacy Policy</h1>
				<p class="legal-intro">
					This is a personal portfolio site. It collects very little information, and only what
					you choose to share by getting in touch.
				</p>
				<p class="legal-updated">Last updated: September 29, 2026</p>
			</header>

			<article class="legal-content">
				<section>
					<h2>Information You Share</h2>
					<p>
						If you contact us through email or a form on this site, we collect what you send —
						typically your name, email address, and message. This is used only to respond to your
						inquiry or continue a conversation you've started. It is never sold or shared with
						third parties for marketing purposes.
					</p>
				</section>

				<section>
					<h2>Case Study Content</h2>
					<p>
						Work samples on this site describe products and platforms designed for third-party
						companies and clients. Displaying that work does not involve collecting, storing, or
						processing any personal data belonging to those companies, their employees, or their
						end users — the screenshots and descriptions shown are illustrative only. See the
						<a href="/terms">Terms</a> page for details on how that work is owned and used.
					</p>
				</section>

				<section>
					<h2>Analytics and Technical Data</h2>
					<p>
						This site may use basic analytics or hosting logs to understand traffic and diagnose
						issues. This can include browser type, device data, pages visited, and approximate
						geographic region — never anything that directly identifies you.
					</p>
					<p>
						Any optional analytics or marketing tools are only enabled after you grant consent
						through the site's cookie preferences.
					</p>
				</section>

				<section>
					<h2>Cookies and Browser Storage</h2>
					<p>
						This site uses browser storage for essential preferences such as theme selection and
						cookie consent choices. Optional analytics and marketing categories can be controlled
						by you through the cookie banner and preferences modal.
					</p>
					<p>
						For a fuller overview of how consent is stored, see the <a href="/cookies">Cookie
						Policy</a>.
					</p>
				</section>

				<section>
					<h2>Third-Party Services</h2>
					<p>
						This site may link to third-party services — live products referenced in case studies,
						LinkedIn, Behance, or embedded content. Those services process information according
						to their own privacy policies, which we encourage you to review.
					</p>
				</section>

				<section>
					<h2>Changes to This Policy</h2>
					<p>
						This policy may be updated from time to time. Any changes will be reflected on this
						page with an updated revision date.
					</p>
				</section>

				<section>
					<h2>Contact</h2>
					<p>
						Questions about this policy can be directed to
						<a href="mailto:hassan.mujtaba715@gmail.com">hassan.mujtaba715@gmail.com</a>.
					</p>
				</section>
			</article>
		</main>
	</div>
</Layout>

<style>
	.legal-page {
		width: min(calc(100% - 3rem), 62rem);
		margin: 0 auto;
		padding: 1.25rem 0 5rem;
	}

	.legal-main {
		padding: 5rem 0 0;
	}

	.legal-header {
		max-width: 46rem;
	}

	.legal-updated {
		margin: 0;
		font-size: 0.95rem;
		line-height: 1.6;
		color: var(--muted-foreground);
	}

	.legal-updated {
		margin-top: 1.25rem;
	}

	h1 {
		margin: 0;
		font-size: clamp(2.5rem, 4.2vw, 3.9rem);
		line-height: 1.05;
		letter-spacing: -0.05em;
		font-weight: 800;
	}

	.legal-intro,
	.legal-content p {
		font-size: 1.05rem;
		line-height: 1.75;
	}

	.legal-intro {
		margin: 1.5rem 0 0;
		color: var(--muted-foreground);
	}

	.legal-content {
		margin-top: 3rem;
		padding-top: 2rem;
		border-top: 1px solid var(--border);
	}

	.legal-content section + section {
		margin-top: 2.5rem;
	}

	h2 {
		margin: 0 0 0.85rem;
		font-size: 1.35rem;
		line-height: 1.2;
		letter-spacing: -0.03em;
	}

	.legal-content p {
		margin: 0;
		max-width: 46rem;
	}

	.legal-content p + p {
		margin-top: 1rem;
	}

	.legal-content a {
		color: inherit;
		font-weight: 700;
	}

	@media (max-width: 720px) {
		.legal-page {
			width: min(calc(100% - 2.5rem), 62rem);
			padding-top: 1rem;
		}

		.legal-main {
			padding-top: 4rem;
		}
	}
</style>
