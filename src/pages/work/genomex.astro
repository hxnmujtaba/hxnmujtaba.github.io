---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { siteConfig } from '../../config/site';
import coverImage from '../../assets/images/case-studies/genomex-cover.png';
import detailsImage from '../../assets/images/case-studies/genomex-details.png';
import login1 from '../../assets/images/case-studies/genomex-login-1.png';
import login2 from '../../assets/images/case-studies/genomex-login-2.png';
import login3 from '../../assets/images/case-studies/genomex-login-3.png';
import dashboardToday from '../../assets/images/case-studies/genomex-dashboard-today.png';
import dashboardWeekly from '../../assets/images/case-studies/genomex-dashboard-weekly.png';
import dashboardMonthly from '../../assets/images/case-studies/genomex-dashboard-monthly.png';
import progress1 from '../../assets/images/case-studies/genomex-progress-1.png';
import progress2 from '../../assets/images/case-studies/genomex-progress-2.png';
import progress3 from '../../assets/images/case-studies/genomex-progress-3.png';
import progress4 from '../../assets/images/case-studies/genomex-progress-4.png';
import progress5 from '../../assets/images/case-studies/genomex-progress-5.png';
import progress6 from '../../assets/images/case-studies/genomex-progress-6.png';
import progress7 from '../../assets/images/case-studies/genomex-progress-7.png';
import progress8 from '../../assets/images/case-studies/genomex-progress-8.png';
import progress9 from '../../assets/images/case-studies/genomex-progress-9.png';

const highlights = [
	{ label: 'Role', value: 'End-to-End Product Design' },
	{ label: 'Domain', value: 'AI-Powered Fitness' },
	{ label: 'Platform', value: 'iOS Mobile App' },
];

const scope = [
	'SNP Genetic Data Interpretation',
	'AI-Generated, Adaptive Workout Plans',
	'Apple HealthKit Integration',
	'Mood-Based Training Adjustments',
	'GeneX AI Chat Assistant',
	'Performance Analytics & Insights',
];

const role = [
	'End-to-end product design',
	'Adaptive workout-state design',
	'AI interaction & conversation design',
	'High-fidelity UI & prototyping',
];

const designDecisions = [
	{
		title: 'Designing adaptive workout states',
		detail:
			'AI-assisted scenario modeling simulated real-world conditions — health data changes, mood selection, skipped workouts — enabling flexible workout states that clearly communicate adjustments and intent.',
	},
	{
		title: 'Human-AI collaboration over full automation',
		detail:
			'AI-supported copy exploration and UX iteration informed transparency patterns, helping users understand why workouts change — building trust and a sense of control alongside automation.',
	},
];

const analytics = ['Current Readiness to Goal', 'Weekly Progress Overview', 'Recovery Score & Training Load Trends'];

const loginScreens = [
	{ img: login1, alt: 'GenomeX login with social and phone sign-in options' },
	{ img: login2, alt: 'GenomeX phone number login' },
	{ img: login3, alt: 'GenomeX email login' },
];

const dashboardScreens = [
	{ img: dashboardToday, alt: 'GenomeX dashboard, daily view' },
	{ img: dashboardWeekly, alt: 'GenomeX dashboard, weekly view' },
	{ img: dashboardMonthly, alt: 'GenomeX dashboard, monthly view' },
];

const progressScreens = [progress1, progress2, progress3, progress4, progress5, progress6, progress7, progress8, progress9].map(
	(img, i) => ({ img, alt: `GenomeX My Progress screen ${i + 1}` }),
);

const caseStudyUrl = new URL('/work/genomex', siteConfig.siteUrl).toString();
const caseStudySchema = [
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: 'Home', item: siteConfig.siteUrl },
			{ '@type': 'ListItem', position: 2, name: 'Work', item: new URL('/work', siteConfig.siteUrl).toString() },
			{ '@type': 'ListItem', position: 3, name: 'GenomeX Case Study', item: caseStudyUrl },
		],
	},
	{
		'@context': 'https://schema.org',
		'@type': 'CreativeWork',
		name: 'GenomeX Case Study',
		headline: 'GenomeX — AI Workout Planner for Athletes',
		description:
			'A genetics-driven training platform translating SNP data and real-time biometrics into adaptive, AI-generated workout plans.',
		url: caseStudyUrl,
		author: { '@type': 'Person', name: siteConfig.authorName },
		isPartOf: { '@type': 'WebSite', name: siteConfig.name, url: siteConfig.siteUrl },
		inLanguage: siteConfig.locale,
	},
];
---

<Layout
	title="GenomeX Case Study | Hassan Mujtaba"
	description="GenomeX — an AI-powered workout planner translating genetic and physiological data into adaptive training programs for athletes."
	ogType="article"
	ogImageAlt="GenomeX AI workout planner app preview"
	schema={caseStudySchema}
>
	<a class="skip-link" href="#main-content">Skip to content</a>

	<div class="case-page">
		<SiteHeader />

		<main id="main-content">
			<section class="case-hero">
				<p class="eyebrow">
					<a class="breadcrumb-link" href="/work">Case Study</a>
					<span class="breadcrumb-separator" aria-hidden="true">/</span>
					<span>GenomeX</span>
				</p>
				<h1 class="display-title">GenomeX — AI Workout Planner for Athletes</h1>
				<div class="hero-subgrid">
					<p class="hero-text">
						An AI-powered workout planning app for athletes seeking deeply personalized, adaptive
						training — driven by genetic and physiological data, and continuously recalibrated
						against real-world progress.
					</p>
				</div>
			</section>

			<section class="meta-strip" id="overview">
				{highlights.map((item) => (
					<div class="meta-item">
						<p class="meta-label">{item.label}</p>
						<p class="meta-value">{item.value}</p>
					</div>
				))}
			</section>

			<section class="lead-image-section">
				<Image class="lead-image" src={coverImage} alt="GenomeX AI workout planner app preview" decoding="async" widths={[720, 1080, 1440]} sizes="(max-width: 78rem) 100vw, 78rem" />
			</section>

			<section class="summary-section">
				<p class="section-kicker">Overview</p>
				<h2>Genetics and real-time biometrics, turned into a daily training plan.</h2>
				<div class="summary-main">
					<p>
						GenomeX uses SNP (Single Nucleotide Polymorphism) data alongside user inputs — fitness
						level, current routine, available equipment, and goals — processed by GeneX, an AI
						fitness assistant that translates genetic and lifestyle information into a structured
						workout plan built to hit results within a defined timeframe.
					</p>
					<p>
						It integrates with Apple HealthKit to continuously ingest daily vitals and activity
						metrics. GeneX evaluates that real-time data to dynamically adjust upcoming
						workouts, keeping intensity, recovery, and readiness balanced as the user progresses.
					</p>
					<p>
						A daily mood-based adjustment system — Energized, Fatigued, In Pain — lets athletes
						modify training intensity without derailing long-term goals, with future workouts
						recalibrated automatically. A dedicated chat interface puts GeneX on call anytime for
						workout guidance, performance insights, or fitness questions.
					</p>
					<p><strong>Product scope:</strong></p>
					<ul class="outcome-list">
						{scope.map((item) => <li>{item}</li>)}
					</ul>
				</div>
			</section>

			<section class="editorial-section editorial-section-no-divider" id="role">
				<div class="section-rail">
					<p class="section-kicker">My Role</p>
				</div>
				<div class="story-block">
					<ul class="outcome-list">
						{role.map((item) => <li>{item}</li>)}
					</ul>
				</div>
			</section>

			<section class="editorial-section" id="design-decisions">
				<div class="section-rail">
					<p class="section-kicker">Key Design Decisions (AI-Assisted)</p>
				</div>
				<div class="story-block">
					{designDecisions.map((item) => (
						<p>
							<strong>{item.title}</strong><br />
							{item.detail}
						</p>
					))}
				</div>
			</section>

			<section class="lead-image-section">
				<Image class="single-image" src={detailsImage} alt="GenomeX design challenges and AI-assisted solutions breakdown" loading="lazy" decoding="async" widths={[480, 720, 960]} sizes="(max-width: 78rem) 100vw, 60rem" />
			</section>

			<section class="editorial-section" id="analytics">
				<div class="section-rail">
					<p class="section-kicker">Performance Analytics</p>
				</div>
				<div class="story-block">
					<ul class="outcome-list">
						{analytics.map((item) => <li>{item}</li>)}
					</ul>
					<p class="closing-text">
						AI-generated insights that keep training readiness, recovery, and load trends legible
						at a glance.
					</p>
				</div>
			</section>

			<section class="editorial-section" id="onboarding">
				<div class="section-rail">
					<p class="section-kicker">Sign In</p>
				</div>
				<div class="story-block">
					<div class="gallery-grid gallery-grid-3">
						{loginScreens.map((item) => (
							<Image class="gallery-image" src={item.img} alt={item.alt} loading="lazy" decoding="async" widths={[320, 480, 640]} sizes="(max-width: 860px) 50vw, 33vw" />
						))}
					</div>
				</div>
			</section>

			<section class="editorial-section" id="dashboard">
				<div class="section-rail">
					<p class="section-kicker">Dashboard</p>
				</div>
				<div class="story-block">
					<div class="gallery-grid gallery-grid-3">
						{dashboardScreens.map((item) => (
							<Image class="gallery-image" src={item.img} alt={item.alt} loading="lazy" decoding="async" widths={[320, 480, 640]} sizes="(max-width: 860px) 50vw, 33vw" />
						))}
					</div>
				</div>
			</section>

			<section class="editorial-section" id="my-progress">
				<div class="section-rail">
					<p class="section-kicker">My Progress</p>
				</div>
				<div class="story-block">
					<div class="gallery-grid gallery-grid-3">
						{progressScreens.map((item) => (
							<Image class="gallery-image" src={item.img} alt={item.alt} loading="lazy" decoding="async" widths={[320, 480, 640]} sizes="(max-width: 860px) 50vw, 33vw" />
						))}
					</div>
				</div>
			</section>
		</main>
	</div>
</Layout>

<style>
	.case-page {
		position: relative;
		width: min(calc(100% - 3rem), 78rem);
		margin: 0 auto;
		padding: 1.25rem 0 5rem;
	}

	.eyebrow,
	.meta-label,
	.section-kicker {
		font-family: var(--font-mono);
		font-size: 0.82rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		line-height: 1.4;
		text-transform: uppercase;
	}

	.eyebrow a {
		display: inline-flex;
		align-items: center;
		padding: 0.1rem 0;
		color: var(--foreground);
		text-decoration: none;
		transition: opacity 120ms ease;
	}

	.eyebrow a:hover,
	.eyebrow a:focus-visible {
		opacity: 0.68;
	}

	.case-hero {
		padding: 6rem 0 4rem;
	}

	.eyebrow,
	.meta-label,
	.section-kicker {
		margin: 0;
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.55rem;
		margin-bottom: 1.1rem;
		color: var(--muted-foreground);
		font-style: normal;
	}

	.breadcrumb-link {
		font-weight: 600;
	}

	.breadcrumb-separator {
		color: var(--muted-foreground);
	}

	h1,
	h2 {
		margin: 0;
		font-weight: 800;
		letter-spacing: -0.05em;
		color: var(--foreground);
	}

	.hero-subgrid {
		display: grid;
		grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.7fr);
		gap: 2rem;
		margin-top: 1.75rem;
	}

	.hero-text,
	.summary-main p,
	.story-block p,
	.outcome-list li,
	.closing-text {
		font-size: 1.08rem;
		line-height: 1.7;
	}

	.hero-text,
	.summary-main p,
	.story-block p,
	.closing-text {
		margin: 0;
	}

	.closing-text {
		color: var(--muted-foreground);
	}

	.meta-strip {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 2rem;
		padding: 1.5rem 0 0.5rem;
		border-top: 1px solid var(--border);
	}

	.meta-item {
		padding-top: 0.75rem;
	}

	.meta-value {
		margin: 0.35rem 0 0;
		font-size: 1.15rem;
		font-weight: 700;
	}

	.lead-image-section {
		padding: 2rem 0 4rem;
	}

	.lead-image,
	.single-image,
	.gallery-image {
		width: 100%;
		border: 1px solid var(--border);
		border-radius: 1.5rem;
		box-shadow: var(--shadow-large);
	}

	.gallery-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.25rem;
	}

	.gallery-grid-3 {
		grid-template-columns: repeat(3, minmax(0, 1fr));
	}

	.summary-section {
		padding: 0 0 3rem;
		border-bottom: 1px solid var(--border);
	}

	.summary-section h2 {
		margin-top: 0.75rem;
		font-size: clamp(2rem, 3vw, 3rem);
		line-height: 1.04;
	}

	.summary-main {
		display: grid;
		gap: 1rem;
		margin-top: 1.5rem;
	}

	.editorial-section {
		display: grid;
		grid-template-columns: 16rem minmax(0, 1fr);
		gap: 2rem;
		padding: 2.5rem 0;
		border-bottom: 1px solid var(--border);
	}

	#my-progress {
		border-bottom: 0;
	}

	.editorial-section-no-divider {
		border-bottom: 0;
		padding-bottom: 0;
	}

	.section-rail {
		align-self: start;
	}

	.story-block {
		display: grid;
		gap: 1rem;
		max-width: 52rem;
		margin-top: 0;
	}

	.story-block strong {
		color: var(--foreground);
	}

	.outcome-list {
		margin: 0;
		padding-left: 1.25rem;
		list-style: disc;
		display: grid;
		gap: 0.4rem;
	}

	.outcome-list li::marker {
		color: var(--foreground);
	}

	@media (max-width: 980px) {
		.hero-subgrid,
		.meta-strip {
			grid-template-columns: 1fr;
		}

		.gallery-grid-3 {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 560px) {
		.gallery-grid,
		.gallery-grid-3 {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 720px) {
		.case-page {
			width: min(calc(100% - 1.5rem), 78rem);
			padding-top: 1rem;
		}

		.editorial-section {
			grid-template-columns: 1fr;
		}

		.case-hero {
			padding: 4rem 0 3rem;
		}

		.hero-text,
		.summary-main p,
		.story-block p,
		.outcome-list li,
		.closing-text {
			font-size: 1.05rem;
		}
	}
</style>
