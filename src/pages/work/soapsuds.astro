---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { siteConfig } from '../../config/site';
import coverImage from '../../assets/images/other-projects/soapsuds.png';
import loginImage from '../../assets/images/case-studies/soapsuds-login.png';
import onboarding1Image from '../../assets/images/case-studies/soapsuds-onboarding-1.png';
import onboarding2Image from '../../assets/images/case-studies/soapsuds-onboarding-2.png';
import onboarding3Image from '../../assets/images/case-studies/soapsuds-onboarding-3.png';
import onboarding4Image from '../../assets/images/case-studies/soapsuds-onboarding-4.png';
import visitsImage from '../../assets/images/case-studies/soapsuds-visits.png';
import captureRecordingImage from '../../assets/images/case-studies/soapsuds-capture-recording.png';
import captureNewRecordingImage from '../../assets/images/case-studies/soapsuds-capture-new-recording.png';
import captureUploadingImage from '../../assets/images/case-studies/soapsuds-capture-uploading.png';
import visitDetailNoteImage from '../../assets/images/case-studies/soapsuds-visit-detail-note.png';
import visitDetailTranscriptionImage from '../../assets/images/case-studies/soapsuds-visit-detail-transcription.png';
import visitDetailDiagnosisImage from '../../assets/images/case-studies/soapsuds-visit-detail-diagnosis.png';
import templatesImage from '../../assets/images/case-studies/soapsuds-templates.png';
import templatesAddPopupImage from '../../assets/images/case-studies/soapsuds-templates-add-popup.png';
import settingsAccountImage from '../../assets/images/case-studies/soapsuds-settings-account.png';
import settingsNotePreferencesImage from '../../assets/images/case-studies/soapsuds-settings-note-preferences.png';

const highlights = [
	{ label: 'Role', value: 'End-to-End Product Design' },
	{ label: 'Domain', value: 'AI-Powered Healthcare Documentation' },
	{ label: 'Platform', value: 'Web' },
];

const scope = [
	'AI-generated SOAP clinical notes',
	'Visit recording & structured documentation',
	'Patient visit management',
	'Magic Edit (AI refinement layer)',
];

const role = [
	'End-to-end product design',
	'UX architecture & workflow design',
	'AI interaction modeling',
	'High-fidelity UI & prototyping',
];

const systemFocus = [
	'Human-in-the-loop AI validation',
	'Structured clinical documentation logic',
	'Clarity in data-dense medical interfaces',
];

const caseStudyUrl = new URL('/work/soapsuds', siteConfig.siteUrl).toString();
const caseStudySchema = [
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: 'Home', item: siteConfig.siteUrl },
			{ '@type': 'ListItem', position: 2, name: 'Work', item: new URL('/work', siteConfig.siteUrl).toString() },
			{ '@type': 'ListItem', position: 3, name: 'SOAPsuds Case Study', item: caseStudyUrl },
		],
	},
	{
		'@context': 'https://schema.org',
		'@type': 'CreativeWork',
		name: 'SOAPsuds Case Study',
		headline: 'SOAPsuds — AI-Powered Clinical Notes & Scribing Platform',
		description:
			'An AI-assisted clinical documentation platform helping clinicians generate structured SOAP notes from visit recordings.',
		url: caseStudyUrl,
		author: { '@type': 'Person', name: siteConfig.authorName },
		isPartOf: { '@type': 'WebSite', name: siteConfig.name, url: siteConfig.siteUrl },
		inLanguage: siteConfig.locale,
	},
];
---

<Layout
	title="SOAPsuds Case Study | Hassan Mujtaba"
	description="SOAPsuds — an AI-powered clinical notes and scribing platform designed to streamline AI-assisted medical documentation for clinicians."
	ogType="article"
	ogImageAlt="SOAPsuds clinical notes platform preview"
	schema={caseStudySchema}
>
	<a class="skip-link" href="#main-content">Skip to content</a>

	<div class="case-page">
		<SiteHeader />

		<main id="main-content">
			<section class="case-hero">
				<p class="eyebrow">
					<a class="breadcrumb-link" href="/work">Case Study</a>
					<span class="breadcrumb-separator" aria-hidden="true">/</span>
					<span>SOAPsuds</span>
				</p>
				<h1 class="display-title">SOAPsuds — AI-Powered Clinical Notes & Scribing</h1>
				<div class="hero-subgrid">
					<p class="hero-text">
						An AI-assisted documentation platform built to turn patient visits into structured
						SOAP notes — reducing the manual charting burden on clinicians while keeping a
						human-in-the-loop for every edit.
						<a class="hero-link" href="https://soapsuds.io" target="_blank" rel="noopener">soapsuds.io</a>
					</p>
				</div>
			</section>

			<section class="meta-strip" id="overview">
				{highlights.map((item) => (
					<div class="meta-item">
						<p class="meta-label">{item.label}</p>
						<p class="meta-value">{item.value}</p>
					</div>
				))}
			</section>

			<section class="lead-image-section">
				<Image class="lead-image" src={coverImage} alt="SOAPsuds clinical notes dashboard preview" decoding="async" widths={[720, 1080, 1440]} sizes="(max-width: 78rem) 100vw, 78rem" />
			</section>

			<section class="summary-section">
				<p class="section-kicker">Overview</p>
				<h2>Structured clinical notes, generated with the clinician still in control.</h2>
				<div class="summary-main">
					<p>
						SOAPsuds was designed from scratch to streamline AI-assisted medical documentation —
						turning recorded visits into structured, editable SOAP notes clinicians can trust.
					</p>
					<p><strong>Product scope:</strong></p>
					<ul class="outcome-list">
						{scope.map((item) => <li>{item}</li>)}
					</ul>
				</div>
			</section>

			<section class="editorial-section editorial-section-no-divider" id="role">
				<div class="section-rail">
					<p class="section-kicker">My Role</p>
				</div>
				<div class="story-block">
					<ul class="outcome-list">
						{role.map((item) => <li>{item}</li>)}
					</ul>
				</div>
			</section>

			<section class="editorial-section" id="login">
				<div class="section-rail">
					<p class="section-kicker">Login</p>
				</div>
				<div class="story-block">
					<Image class="single-image" src={loginImage} alt="SOAPsuds login screen" loading="lazy" decoding="async" widths={[720, 1080, 1440]} sizes="(max-width: 78rem) 100vw, 78rem" />
				</div>
			</section>

			<section class="editorial-section" id="onboarding">
				<div class="section-rail">
					<p class="section-kicker">Onboarding</p>
				</div>
				<div class="story-block">
					<p>Guided setup — including the option to create a note from an existing upload:</p>
					<Image class="single-image" src={onboarding1Image} alt="SOAPsuds onboarding screen 1" loading="lazy" decoding="async" widths={[720, 1080, 1440]} sizes="(max-width: 78rem) 100vw, 78rem" />
					<Image class="single-image" src={onboarding2Image} alt="SOAPsuds onboarding screen 2" loading="lazy" decoding="async" widths={[720, 1080, 1440]} sizes="(max-width: 78rem) 100vw, 78rem" />
					<Image class="single-image" src={onboarding3Image} alt="SOAPsuds onboarding screen 3" loading="lazy" decoding="async" widths={[720, 1080, 1440]} sizes="(max-width: 78rem) 100vw, 78rem" />
					<Image class="single-image" src={onboarding4Image} alt="SOAPsuds onboarding create note with existing upload screen" loading="lazy" decoding="async" widths={[720, 1080, 1440]} sizes="(max-width: 78rem) 100vw, 78rem" />
				</div>
			</section>

			<section class="editorial-section" id="visits">
				<div class="section-rail">
					<p class="section-kicker">Visits</p>
				</div>
				<div class="story-block">
					<Image class="single-image" src={visitsImage} alt="SOAPsuds visits list screen" loading="lazy" decoding="async" widths={[720, 1080, 1440]} sizes="(max-width: 78rem) 100vw, 78rem" />
				</div>
			</section>

			<section class="editorial-section" id="capture-conversation">
				<div class="section-rail">
					<p class="section-kicker">Capture Conversation</p>
				</div>
				<div class="story-block">
					<p>Recording, uploading, and processing patient visit conversations:</p>
					<Image class="single-image" src={captureRecordingImage} alt="SOAPsuds capture conversation recording screen" loading="lazy" decoding="async" widths={[720, 1080, 1440]} sizes="(max-width: 78rem) 100vw, 78rem" />
					<Image class="single-image" src={captureNewRecordingImage} alt="SOAPsuds new recording screen" loading="lazy" decoding="async" widths={[720, 1080, 1440]} sizes="(max-width: 78rem) 100vw, 78rem" />
					<Image class="single-image" src={captureUploadingImage} alt="SOAPsuds uploading conversation screen" loading="lazy" decoding="async" widths={[720, 1080, 1440]} sizes="(max-width: 78rem) 100vw, 78rem" />
				</div>
			</section>

			<section class="editorial-section" id="visit-detail">
				<div class="section-rail">
					<p class="section-kicker">Visit Detail / SOAP Note</p>
				</div>
				<div class="story-block">
					<p>Structured SOAP note with transcription and AI clinical diagnosis support:</p>
					<Image class="single-image" src={visitDetailNoteImage} alt="SOAPsuds visit detail SOAP note screen" loading="lazy" decoding="async" widths={[720, 1080, 1440]} sizes="(max-width: 78rem) 100vw, 78rem" />
					<Image class="single-image" src={visitDetailTranscriptionImage} alt="SOAPsuds visit detail SOAP note transcription screen" loading="lazy" decoding="async" widths={[720, 1080, 1440]} sizes="(max-width: 78rem) 100vw, 78rem" />
					<Image class="single-image" src={visitDetailDiagnosisImage} alt="SOAPsuds visit detail AI clinical diagnosis empty state screen" loading="lazy" decoding="async" widths={[720, 1080, 1440]} sizes="(max-width: 78rem) 100vw, 78rem" />
				</div>
			</section>

			<section class="editorial-section" id="templates">
				<div class="section-rail">
					<p class="section-kicker">Templates</p>
				</div>
				<div class="story-block">
					<p>System templates library with the add-new-template flow:</p>
					<Image class="single-image" src={templatesImage} alt="SOAPsuds system templates screen" loading="lazy" decoding="async" widths={[720, 1080, 1440]} sizes="(max-width: 78rem) 100vw, 78rem" />
					<Image class="single-image" src={templatesAddPopupImage} alt="SOAPsuds add new template popup screen" loading="lazy" decoding="async" widths={[720, 1080, 1440]} sizes="(max-width: 78rem) 100vw, 78rem" />
				</div>
			</section>

			<section class="editorial-section" id="settings">
				<div class="section-rail">
					<p class="section-kicker">Settings</p>
				</div>
				<div class="story-block">
					<p>Account profile and note-preference consent settings:</p>
					<Image class="single-image" src={settingsAccountImage} alt="SOAPsuds account settings update profile information screen" loading="lazy" decoding="async" widths={[720, 1080, 1440]} sizes="(max-width: 78rem) 100vw, 78rem" />
					<Image class="single-image" src={settingsNotePreferencesImage} alt="SOAPsuds note preferences consent settings screen" loading="lazy" decoding="async" widths={[720, 1080, 1440]} sizes="(max-width: 78rem) 100vw, 78rem" />
				</div>
			</section>

			<section class="editorial-section" id="system-focus">
				<div class="section-rail">
					<p class="section-kicker">System Focus</p>
				</div>
				<div class="story-block">
					<ul class="outcome-list">
						{systemFocus.map((item) => <li>{item}</li>)}
					</ul>
					<p class="closing-text">
						Built as a scalable foundation for AI-assisted healthcare workflows.
					</p>
				</div>
			</section>
		</main>
	</div>
</Layout>

<style>
	.case-page {
		position: relative;
		width: min(calc(100% - 3rem), 78rem);
		margin: 0 auto;
		padding: 1.25rem 0 5rem;
	}

	.eyebrow,
	.meta-label,
	.section-kicker {
		font-family: var(--font-mono);
		font-size: 0.82rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		line-height: 1.4;
		text-transform: uppercase;
	}

	.eyebrow a {
		display: inline-flex;
		align-items: center;
		padding: 0.1rem 0;
		color: var(--foreground);
		text-decoration: none;
		transition: opacity 120ms ease;
	}

	.eyebrow a:hover,
	.eyebrow a:focus-visible {
		opacity: 0.68;
	}

	.case-hero {
		padding: 6rem 0 4rem;
	}

	.eyebrow,
	.meta-label,
	.section-kicker {
		margin: 0;
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.55rem;
		margin-bottom: 1.1rem;
		color: var(--muted-foreground);
		font-style: normal;
	}

	.breadcrumb-link {
		font-weight: 600;
	}

	.breadcrumb-separator {
		color: var(--muted-foreground);
	}

	h1,
	h2 {
		margin: 0;
		font-weight: 800;
		letter-spacing: -0.05em;
		color: var(--foreground);
	}

	.hero-subgrid {
		display: grid;
		grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.7fr);
		gap: 2rem;
		margin-top: 1.75rem;
	}

	.hero-text,
	.summary-main p,
	.story-block p,
	.outcome-list li,
	.closing-text {
		font-size: 1.08rem;
		line-height: 1.7;
	}

	.hero-text,
	.summary-main p,
	.story-block p,
	.closing-text {
		margin: 0;
	}

	.hero-link {
		display: inline-block;
		margin-left: 0.35rem;
		color: var(--accent-link);
	}

	.closing-text {
		color: var(--muted-foreground);
	}

	.meta-strip {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 2rem;
		padding: 1.5rem 0 0.5rem;
		border-top: 1px solid var(--border);
	}

	.meta-item {
		padding-top: 0.75rem;
	}

	.meta-value {
		margin: 0.35rem 0 0;
		font-size: 1.15rem;
		font-weight: 700;
	}

	.lead-image-section {
		padding: 2rem 0 4rem;
	}

	.lead-image {
		width: 100%;
		max-width: 46rem;
		margin: 0 auto;
		display: block;
		border: 1px solid var(--border);
		border-radius: 1.5rem;
		box-shadow: var(--shadow-large);
	}

	.single-image {
		width: 100%;
		margin-top: 0.5rem;
		border: 1px solid var(--border);
		border-radius: 1.5rem;
		box-shadow: var(--shadow-large);
	}

	.summary-section {
		padding: 0 0 3rem;
		border-bottom: 1px solid var(--border);
	}

	.summary-section h2 {
		margin-top: 0.75rem;
		font-size: clamp(2rem, 3vw, 3rem);
		line-height: 1.04;
	}

	.summary-main {
		display: grid;
		gap: 1rem;
		margin-top: 1.5rem;
	}

	.editorial-section {
		display: grid;
		grid-template-columns: 16rem minmax(0, 1fr);
		gap: 2rem;
		padding: 2.5rem 0;
		border-bottom: 1px solid var(--border);
	}

	#system-focus {
		border-bottom: 0;
	}

	.editorial-section-no-divider {
		border-bottom: 0;
		padding-bottom: 0;
	}

	.section-rail {
		align-self: start;
	}

	.story-block {
		display: grid;
		gap: 1rem;
		max-width: 52rem;
		margin-top: 0;
	}

	.outcome-list {
		margin: 0;
		padding-left: 1.25rem;
		list-style: disc;
		display: grid;
		gap: 0.4rem;
	}

	.outcome-list li::marker {
		color: var(--foreground);
	}

	@media (max-width: 980px) {
		.hero-subgrid,
		.meta-strip {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 720px) {
		.case-page {
			width: min(calc(100% - 2.5rem), 78rem);
			padding-top: 1rem;
		}

		.editorial-section {
			grid-template-columns: 1fr;
		}

		.case-hero {
			padding: 4rem 0 3rem;
		}

		.hero-text,
		.summary-main p,
		.story-block p,
		.outcome-list li,
		.closing-text {
			font-size: 1.05rem;
		}
	}
</style>
