---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { siteConfig } from '../../config/site';
import coverImage from '../../assets/images/other-projects/boxtr.png';

const highlights = [
	{ label: 'Role', value: 'UX Architecture & Workflow Structuring' },
	{ label: 'Domain', value: 'Enterprise Intranet & Collaboration' },
	{ label: 'Platform', value: 'Web & Mobile' },
];

const scope = [
	'Organizational newsfeed & announcements',
	'Event & meeting management',
	'Group & 1:1 communication',
	'Task & training modules',
	'AI chatbot integration',
];

const role = [
	'UX architecture & workflow structuring',
	'End-to-end UX & UI design',
	'High-fidelity UI & prototyping',
];

const systemFocus = [
	'Multi-franchise organizational structure',
	'Role-based access & internal workflows',
	'Unified communication & task logic',
];

const caseStudyUrl = new URL('/work/boxtr', siteConfig.siteUrl).toString();
const caseStudySchema = [
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: 'Home', item: siteConfig.siteUrl },
			{ '@type': 'ListItem', position: 2, name: 'Work', item: new URL('/work', siteConfig.siteUrl).toString() },
			{ '@type': 'ListItem', position: 3, name: 'Boxtr Case Study', item: caseStudyUrl },
		],
	},
	{
		'@context': 'https://schema.org',
		'@type': 'CreativeWork',
		name: 'Boxtr Case Study',
		headline: 'Boxtr — Intranet & Collaboration Platform',
		description:
			'An enterprise workspace platform for communication, training, and cross-team collaboration.',
		url: caseStudyUrl,
		author: { '@type': 'Person', name: siteConfig.authorName },
		isPartOf: { '@type': 'WebSite', name: siteConfig.name, url: siteConfig.siteUrl },
		inLanguage: siteConfig.locale,
	},
];
---

<Layout
	title="Boxtr Case Study | Hassan Mujtaba"
	description="Boxtr — an enterprise intranet and collaboration platform centralizing communication, training, and workflows across distributed teams."
	ogType="article"
	ogImageAlt="Boxtr intranet collaboration platform preview"
	schema={caseStudySchema}
>
	<a class="skip-link" href="#main-content">Skip to content</a>

	<div class="case-page">
		<SiteHeader />

		<main id="main-content">
			<section class="case-hero">
				<p class="eyebrow">
					<a class="breadcrumb-link" href="/work">Case Study</a>
					<span class="breadcrumb-separator" aria-hidden="true">/</span>
					<span>Boxtr</span>
				</p>
				<h1 class="display-title">Boxtr — Intranet & Collaboration Platform</h1>
				<div class="hero-subgrid">
					<p class="hero-text">
						An enterprise workspace platform built to centralize communication and operational
						workflows across distributed, multi-franchise teams.
					</p>
				</div>
			</section>

			<section class="meta-strip" id="overview">
				{highlights.map((item) => (
					<div class="meta-item">
						<p class="meta-label">{item.label}</p>
						<p class="meta-value">{item.value}</p>
					</div>
				))}
			</section>

			<section class="lead-image-section">
				<Image class="lead-image" src={coverImage} alt="Boxtr intranet collaboration platform preview" decoding="async" widths={[720, 1080, 1440]} sizes="(max-width: 78rem) 100vw, 78rem" />
			</section>

			<section class="summary-section">
				<p class="section-kicker">Overview</p>
				<h2>One workspace for distributed, multi-franchise teams.</h2>
				<div class="summary-main">
					<p>
						Boxtr brings newsfeed, task management, training, and internal communication into a
						single intranet workspace — structured around role-based access and multi-franchise
						organizational logic.
					</p>
					<p><strong>Product scope:</strong></p>
					<ul class="outcome-list">
						{scope.map((item) => <li>{item}</li>)}
					</ul>
				</div>
			</section>

			<section class="editorial-section editorial-section-no-divider" id="role">
				<div class="section-rail">
					<p class="section-kicker">My Role</p>
				</div>
				<div class="story-block">
					<ul class="outcome-list">
						{role.map((item) => <li>{item}</li>)}
					</ul>
				</div>
			</section>

			<section class="editorial-section" id="system-focus">
				<div class="section-rail">
					<p class="section-kicker">System Focus</p>
				</div>
				<div class="story-block">
					<ul class="outcome-list">
						{systemFocus.map((item) => <li>{item}</li>)}
					</ul>
					<p class="closing-text">
						Designed to centralize communication and operational workflows across distributed
						teams.
					</p>
				</div>
			</section>
		</main>
	</div>
</Layout>

<style>
	.case-page {
		position: relative;
		width: min(calc(100% - 3rem), 78rem);
		margin: 0 auto;
		padding: 1.25rem 0 5rem;
	}

	.eyebrow,
	.meta-label,
	.section-kicker {
		font-family: var(--font-mono);
		font-size: 0.82rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		line-height: 1.4;
		text-transform: uppercase;
	}

	.eyebrow a {
		display: inline-flex;
		align-items: center;
		padding: 0.1rem 0;
		color: var(--foreground);
		text-decoration: none;
		transition: opacity 120ms ease;
	}

	.eyebrow a:hover,
	.eyebrow a:focus-visible {
		opacity: 0.68;
	}

	.case-hero {
		padding: 6rem 0 4rem;
	}

	.eyebrow,
	.meta-label,
	.section-kicker {
		margin: 0;
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.55rem;
		margin-bottom: 1.1rem;
		color: var(--muted-foreground);
		font-style: normal;
	}

	.breadcrumb-link {
		font-weight: 600;
	}

	.breadcrumb-separator {
		color: var(--muted-foreground);
	}

	h1,
	h2 {
		margin: 0;
		font-weight: 800;
		letter-spacing: -0.05em;
		color: var(--foreground);
	}

	.hero-subgrid {
		display: grid;
		grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.7fr);
		gap: 2rem;
		margin-top: 1.75rem;
	}

	.hero-text,
	.summary-main p,
	.story-block p,
	.outcome-list li,
	.closing-text {
		font-size: 1.08rem;
		line-height: 1.7;
	}

	.hero-text,
	.summary-main p,
	.story-block p,
	.closing-text {
		margin: 0;
	}

	.closing-text {
		color: var(--muted-foreground);
	}

	.meta-strip {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 2rem;
		padding: 1.5rem 0 0.5rem;
		border-top: 1px solid var(--border);
	}

	.meta-item {
		padding-top: 0.75rem;
	}

	.meta-value {
		margin: 0.35rem 0 0;
		font-size: 1.15rem;
		font-weight: 700;
	}

	.lead-image-section {
		padding: 2rem 0 4rem;
	}

	.lead-image {
		width: 100%;
		max-width: 46rem;
		margin: 0 auto;
		display: block;
		border: 1px solid var(--border);
		border-radius: 1.5rem;
		box-shadow: var(--shadow-large);
	}

	.summary-section {
		padding: 0 0 3rem;
		border-bottom: 1px solid var(--border);
	}

	.summary-section h2 {
		margin-top: 0.75rem;
		font-size: clamp(2rem, 3vw, 3rem);
		line-height: 1.04;
	}

	.summary-main {
		display: grid;
		gap: 1rem;
		margin-top: 1.5rem;
	}

	.editorial-section {
		display: grid;
		grid-template-columns: 16rem minmax(0, 1fr);
		gap: 2rem;
		padding: 2.5rem 0;
		border-bottom: 1px solid var(--border);
	}

	#system-focus {
		border-bottom: 0;
	}

	.editorial-section-no-divider {
		border-bottom: 0;
		padding-bottom: 0;
	}

	.section-rail {
		align-self: start;
	}

	.story-block {
		display: grid;
		gap: 1rem;
		max-width: 52rem;
		margin-top: 0;
	}

	.outcome-list {
		margin: 0;
		padding-left: 1.25rem;
		list-style: disc;
		display: grid;
		gap: 0.4rem;
	}

	.outcome-list li::marker {
		color: var(--foreground);
	}

	@media (max-width: 980px) {
		.hero-subgrid,
		.meta-strip {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 720px) {
		.case-page {
			width: min(calc(100% - 2.5rem), 78rem);
			padding-top: 1rem;
		}

		.editorial-section {
			grid-template-columns: 1fr;
		}

		.case-hero {
			padding: 4rem 0 3rem;
		}

		.hero-text,
		.summary-main p,
		.story-block p,
		.outcome-list li,
		.closing-text {
			font-size: 1.05rem;
		}
	}
</style>
