---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { siteConfig } from '../../config/site';
import coverImage from '../../assets/images/other-projects/jotai.png';
import meetingsImage from '../../assets/images/case-studies/jotai-meetings.png';
import meetingsImage2 from '../../assets/images/case-studies/jotai-meetings-2.png';
import calendarImage from '../../assets/images/case-studies/jotai-calendar.png';
import noteDetailImage from '../../assets/images/case-studies/jotai-note-detail.png';
import referEarnImage from '../../assets/images/case-studies/jotai-refer-earn.png';

const highlights = [
	{ label: 'Role', value: 'Lead Product Designer' },
	{ label: 'Domain', value: 'AI Meeting Intelligence' },
	{ label: 'Platform', value: 'Web' },
];

const scope = [
	'Real-time meeting transcription',
	'Conversation management',
	'AI-powered summaries & highlights',
	'Action item extraction',
];

const role = [
	'Lead Product Designer',
	'End-to-end UX & UI design',
	'AI interaction & conversation modeling',
	'High-fidelity UI & prototyping',
];

const systemFocus = [
	'Context-aware AI summaries',
	'Structured speaker segmentation',
	'Scalable information architecture for conversations',
];

const caseStudyUrl = new URL('/work/jotai', siteConfig.siteUrl).toString();
const caseStudySchema = [
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: 'Home', item: siteConfig.siteUrl },
			{ '@type': 'ListItem', position: 2, name: 'Work', item: new URL('/work', siteConfig.siteUrl).toString() },
			{ '@type': 'ListItem', position: 3, name: 'Jot.ai Case Study', item: caseStudyUrl },
		],
	},
	{
		'@context': 'https://schema.org',
		'@type': 'CreativeWork',
		name: 'Jot.ai Case Study',
		headline: 'Jot.ai — AI-Powered Meeting Intelligence Platform',
		description:
			'A real-time AI assistant for transcribing meetings, structuring conversations, and extracting actionable insights.',
		url: caseStudyUrl,
		author: { '@type': 'Person', name: siteConfig.authorName },
		isPartOf: { '@type': 'WebSite', name: siteConfig.name, url: siteConfig.siteUrl },
		inLanguage: siteConfig.locale,
	},
];
---

<Layout
	title="Jot.ai Case Study | Hassan Mujtaba"
	description="Jot.ai — an AI-powered meeting intelligence platform that transcribes, structures, and summarizes conversations in real time."
	ogType="article"
	ogImageAlt="Jot.ai meeting intelligence platform preview"
	schema={caseStudySchema}
>
	<a class="skip-link" href="#main-content">Skip to content</a>

	<div class="case-page">
		<SiteHeader />

		<main id="main-content">
			<section class="case-hero">
				<p class="eyebrow">
					<a class="breadcrumb-link" href="/work">Case Study</a>
					<span class="breadcrumb-separator" aria-hidden="true">/</span>
					<span>Jot.ai</span>
				</p>
				<h1 class="display-title">Jot.ai — AI-Powered Meeting Intelligence</h1>
				<div class="hero-subgrid">
					<p class="hero-text">
						A real-time AI assistant that turns unstructured meetings into structured, searchable
						intelligence — transcribing conversations, segmenting speakers, and surfacing action
						items automatically.
					</p>
				</div>
			</section>

			<section class="meta-strip" id="overview">
				{highlights.map((item) => (
					<div class="meta-item">
						<p class="meta-label">{item.label}</p>
						<p class="meta-value">{item.value}</p>
					</div>
				))}
			</section>

			<section class="lead-image-section">
				<Image class="lead-image" src={coverImage} alt="Jot.ai meeting intelligence platform preview" decoding="async" widths={[720, 1080, 1440]} sizes="(max-width: 78rem) 100vw, 78rem" />
			</section>

			<section class="summary-section">
				<p class="section-kicker">Overview</p>
				<h2>Unstructured meetings, turned into structured intelligence.</h2>
				<div class="summary-main">
					<p>
						Jot.ai listens to meetings and produces structured, searchable records — summaries,
						highlights, and action items pulled directly from the conversation.
					</p>
					<p><strong>Product scope:</strong></p>
					<ul class="outcome-list">
						{scope.map((item) => <li>{item}</li>)}
					</ul>
				</div>
			</section>

			<section class="editorial-section editorial-section-no-divider" id="role">
				<div class="section-rail">
					<p class="section-kicker">My Role</p>
				</div>
				<div class="story-block">
					<ul class="outcome-list">
						{role.map((item) => <li>{item}</li>)}
					</ul>
				</div>
			</section>

			<section class="editorial-section" id="meetings">
				<div class="section-rail">
					<p class="section-kicker">Meeting Intelligence</p>
				</div>
				<div class="story-block">
					<p>Structured, searchable meeting records with AI-generated summaries and chat:</p>
					<Image class="single-image" src={meetingsImage} alt="Jot.ai meetings list screen" loading="lazy" decoding="async" widths={[720, 1080, 1440]} sizes="(max-width: 78rem) 100vw, 78rem" />
					<Image class="single-image" src={meetingsImage2} alt="Jot.ai meeting detail screen" loading="lazy" decoding="async" widths={[720, 1080, 1440]} sizes="(max-width: 78rem) 100vw, 78rem" />
				</div>
			</section>

			<section class="editorial-section" id="calendar">
				<div class="section-rail">
					<p class="section-kicker">Calendar</p>
				</div>
				<div class="story-block">
					<p>A unified view of upcoming and past meetings, synced across the workspace:</p>
					<Image class="single-image" src={calendarImage} alt="Jot.ai calendar screen" loading="lazy" decoding="async" widths={[720, 1080, 1440]} sizes="(max-width: 78rem) 100vw, 78rem" />
				</div>
			</section>

			<section class="editorial-section" id="note-detail">
				<div class="section-rail">
					<p class="section-kicker">Note Detail</p>
				</div>
				<div class="story-block">
					<p>AI-generated summary alongside a conversational chat layer for deeper follow-up:</p>
					<Image class="single-image" src={noteDetailImage} alt="Jot.ai note detail with summary and AI chat screen" loading="lazy" decoding="async" widths={[720, 1080, 1440]} sizes="(max-width: 78rem) 100vw, 78rem" />
				</div>
			</section>

			<section class="editorial-section" id="refer-earn">
				<div class="section-rail">
					<p class="section-kicker">Refer &amp; Earn</p>
				</div>
				<div class="story-block">
					<p>A built-in referral system to drive organic growth:</p>
					<Image class="single-image" src={referEarnImage} alt="Jot.ai refer and earn screen" loading="lazy" decoding="async" widths={[720, 1080, 1440]} sizes="(max-width: 78rem) 100vw, 78rem" />
				</div>
			</section>

			<section class="editorial-section" id="system-focus">
				<div class="section-rail">
					<p class="section-kicker">System Focus</p>
				</div>
				<div class="story-block">
					<ul class="outcome-list">
						{systemFocus.map((item) => <li>{item}</li>)}
					</ul>
					<p class="closing-text">
						Designed to transform unstructured meetings into structured, searchable intelligence.
					</p>
				</div>
			</section>
		</main>
	</div>
</Layout>

<style>
	.case-page {
		position: relative;
		width: min(calc(100% - 3rem), 78rem);
		margin: 0 auto;
		padding: 1.25rem 0 5rem;
	}

	.eyebrow,
	.meta-label,
	.section-kicker {
		font-family: var(--font-mono);
		font-size: 0.82rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		line-height: 1.4;
		text-transform: uppercase;
	}

	.eyebrow a {
		display: inline-flex;
		align-items: center;
		padding: 0.1rem 0;
		color: var(--foreground);
		text-decoration: none;
		transition: opacity 120ms ease;
	}

	.eyebrow a:hover,
	.eyebrow a:focus-visible {
		opacity: 0.68;
	}

	.case-hero {
		padding: 6rem 0 4rem;
	}

	.eyebrow,
	.meta-label,
	.section-kicker {
		margin: 0;
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.55rem;
		margin-bottom: 1.1rem;
		color: var(--muted-foreground);
		font-style: normal;
	}

	.breadcrumb-link {
		font-weight: 600;
	}

	.breadcrumb-separator {
		color: var(--muted-foreground);
	}

	h1,
	h2 {
		margin: 0;
		font-weight: 800;
		letter-spacing: -0.05em;
		color: var(--foreground);
	}

	.hero-subgrid {
		display: grid;
		grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.7fr);
		gap: 2rem;
		margin-top: 1.75rem;
	}

	.hero-text,
	.summary-main p,
	.story-block p,
	.outcome-list li,
	.closing-text {
		font-size: 1.08rem;
		line-height: 1.7;
	}

	.hero-text,
	.summary-main p,
	.story-block p,
	.closing-text {
		margin: 0;
	}

	.closing-text {
		color: var(--muted-foreground);
	}

	.meta-strip {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 2rem;
		padding: 1.5rem 0 0.5rem;
		border-top: 1px solid var(--border);
	}

	.meta-item {
		padding-top: 0.75rem;
	}

	.meta-value {
		margin: 0.35rem 0 0;
		font-size: 1.15rem;
		font-weight: 700;
	}

	.lead-image-section {
		padding: 2rem 0 4rem;
	}

	.lead-image {
		width: 100%;
		max-width: 46rem;
		margin: 0 auto;
		display: block;
		border: 1px solid var(--border);
		border-radius: 1.5rem;
		box-shadow: var(--shadow-large);
	}

	.single-image {
		width: 100%;
		margin-top: 0.5rem;
		border: 1px solid var(--border);
		border-radius: 1.5rem;
		box-shadow: var(--shadow-large);
	}

	.summary-section {
		padding: 0 0 3rem;
		border-bottom: 1px solid var(--border);
	}

	.summary-section h2 {
		margin-top: 0.75rem;
		font-size: clamp(2rem, 3vw, 3rem);
		line-height: 1.04;
	}

	.summary-main {
		display: grid;
		gap: 1rem;
		margin-top: 1.5rem;
	}

	.editorial-section {
		display: grid;
		grid-template-columns: 16rem minmax(0, 1fr);
		gap: 2rem;
		padding: 2.5rem 0;
		border-bottom: 1px solid var(--border);
	}

	#system-focus {
		border-bottom: 0;
	}

	.editorial-section-no-divider {
		border-bottom: 0;
		padding-bottom: 0;
	}

	.section-rail {
		align-self: start;
	}

	.story-block {
		display: grid;
		gap: 1rem;
		max-width: 52rem;
		margin-top: 0;
	}

	.outcome-list {
		margin: 0;
		padding-left: 1.25rem;
		list-style: disc;
		display: grid;
		gap: 0.4rem;
	}

	.outcome-list li::marker {
		color: var(--foreground);
	}

	@media (max-width: 980px) {
		.hero-subgrid,
		.meta-strip {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 720px) {
		.case-page {
			width: min(calc(100% - 2.5rem), 78rem);
			padding-top: 1rem;
		}

		.editorial-section {
			grid-template-columns: 1fr;
		}

		.case-hero {
			padding: 4rem 0 3rem;
		}

		.hero-text,
		.summary-main p,
		.story-block p,
		.outcome-list li,
		.closing-text {
			font-size: 1.05rem;
		}
	}
</style>
