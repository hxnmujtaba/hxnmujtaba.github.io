---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { siteConfig } from '../../config/site';
import coverImage from '../../assets/images/case-studies/pretelio-cover.png';
import productsImage from '../../assets/images/case-studies/pretelio-products.png';
import pricingImage from '../../assets/images/case-studies/pretelio-pricing.png';
import storesImage from '../../assets/images/case-studies/pretelio-stores.png';

const highlights = [
	{ label: 'Role', value: 'Senior Product Designer' },
	{ label: 'Domain', value: 'Retail Intelligence & Loyalty' },
	{ label: 'Platform', value: 'Web SaaS Dashboard' },
];

const responsibilities = [
	'End-to-end UX strategy and execution',
	'Information architecture & system design',
	'Design system creation (tokens, components)',
	'High-fidelity UI and interaction design',
	'Dashboard and data visualization design',
	'Cross-platform experience (Web + Mobile)',
];

const problems = [
	'Lack of control over pricing across regions',
	'Limited visibility into product performance',
	'Difficulty managing localized offers',
	'Disconnected customer experience',
	'Lack of loyalty-driven engagement',
];

const solution = [
	'Dynamic pricing across zones and stores',
	'Real-time visibility into performance',
	'Centralized product and catalogue management',
	'Seamless integration with customer mobile app',
	'Loyalty & rewards system for engagement',
];

const dashboardWidgets = [
	'Inventory Health',
	'Pricing Performance',
	'Store & Zone Coverage',
	'Promotions Tracking',
	'Revenue Insights',
];

const productsFeatures = ['Analytics', 'Status Tracking', 'Pricing Visibility', 'Store Distribution', 'Catalogue Mapping'];

const pricingFeatures = ['Analytics', 'Zone-based Pricing', 'Discount & Override Rules', 'Scheduled Pricing', 'Multi-product Rule Application'];

const storesFeatures = ['Analytics', 'Store Coverage & Availability', 'Catalogue Assignment', 'Regional Distribution Insights', 'Performance Tracking'];

const caseStudyUrl = new URL('/work/pretelio', siteConfig.siteUrl).toString();
const caseStudySchema = [
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: 'Home', item: siteConfig.siteUrl },
			{ '@type': 'ListItem', position: 2, name: 'Work', item: new URL('/work', siteConfig.siteUrl).toString() },
			{ '@type': 'ListItem', position: 3, name: 'Pretelio Case Study', item: caseStudyUrl },
		],
	},
	{
		'@context': 'https://schema.org',
		'@type': 'CreativeWork',
		name: 'Pretelio Case Study',
		headline: 'Pretelio — Retail Intelligence & Loyalty Platform',
		description:
			'Pretelio is a unified retail and loyalty platform that enables businesses to manage products, pricing, and promotions across multiple stores and regions.',
		url: caseStudyUrl,
		author: { '@type': 'Person', name: siteConfig.authorName },
		isPartOf: { '@type': 'WebSite', name: siteConfig.name, url: siteConfig.siteUrl },
		inLanguage: siteConfig.locale,
	},
];
---

<Layout
	title="Pretelio Case Study | Hassan Mujtaba"
	description="Pretelio — a unified retail and loyalty platform for dynamic pricing, localized offers, and customer engagement across multi-store retail ecosystems."
	ogType="article"
	ogImageAlt="Pretelio retail intelligence platform preview"
	schema={caseStudySchema}
>
	<a class="skip-link" href="#main-content">Skip to content</a>

	<div class="case-page">
		<SiteHeader />

		<main id="main-content">
			<section class="case-hero">
				<p class="eyebrow">
					<a class="breadcrumb-link" href="/work">Case Study</a>
					<span class="breadcrumb-separator" aria-hidden="true">/</span>
					<span>Pretelio</span>
				</p>
				<h1 class="display-title">Pretelio — Retail Intelligence & Loyalty Platform</h1>
				<div class="hero-subgrid">
					<p class="hero-text">
						Designing a scalable system for dynamic pricing, localized offers, and customer
						engagement across multi-store retail ecosystems.
					</p>
				</div>
			</section>

			<section class="meta-strip" id="overview">
				{highlights.map((item) => (
					<div class="meta-item">
						<p class="meta-label">{item.label}</p>
						<p class="meta-value">{item.value}</p>
					</div>
				))}
			</section>

			<section class="lead-image-section">
				<Image class="lead-image" src={coverImage} alt="Pretelio retail dashboard overview" decoding="async" widths={[720, 1080, 1440]} sizes="(max-width: 78rem) 100vw, 78rem" />
			</section>

			<section class="summary-section">
				<p class="section-kicker">Overview</p>
				<h2>Unifying pricing, promotions, and loyalty across every store and region.</h2>
				<div class="summary-main">
					<p>
						Pretelio is a unified retail and loyalty platform that enables businesses to manage
						products, pricing, and promotions across multiple stores and regions.
					</p>
					<p>
						It connects backend operations with a customer-facing mobile experience, allowing users
						to discover offers, save on purchases, and earn rewards.
					</p>
				</div>
			</section>

			<section class="editorial-section editorial-section-no-divider" id="responsibilities">
				<div class="section-rail">
					<p class="section-kicker">My Responsibilities</p>
				</div>
				<div class="story-block">
					<ul class="outcome-list">
						{responsibilities.map((item) => <li>{item}</li>)}
					</ul>
				</div>
			</section>

			<section class="editorial-section" id="problem">
				<div class="section-rail">
					<p class="section-kicker">Problem</p>
				</div>
				<div class="story-block">
					<p>Retailers struggled with fragmented systems for pricing, promotions, and store-level operations:</p>
					<ul class="outcome-list">
						{problems.map((item) => <li>{item}</li>)}
					</ul>
				</div>
			</section>

			<section class="editorial-section" id="solution">
				<div class="section-rail">
					<p class="section-kicker">Solution</p>
				</div>
				<div class="story-block">
					<ul class="outcome-list">
						{solution.map((item) => <li>{item}</li>)}
					</ul>
					<p class="closing-text">A single platform to manage operations and drive growth.</p>
				</div>
			</section>

			<section class="editorial-section" id="dashboard">
				<div class="section-rail">
					<p class="section-kicker">Dashboard for Retailers</p>
				</div>
				<div class="story-block">
					<p>A real-time overview of retail operations, designed for quick scanning and actionable insights:</p>
					<ul class="outcome-list">
						{dashboardWidgets.map((item) => <li>{item}</li>)}
					</ul>
				</div>
			</section>

			<section class="editorial-section" id="products">
				<div class="section-rail">
					<p class="section-kicker">Products Management</p>
				</div>
				<div class="story-block">
					<p>A centralized view to manage all products across stores:</p>
					<ul class="outcome-list">
						{productsFeatures.map((item) => <li>{item}</li>)}
					</ul>
					<Image class="single-image" src={productsImage} alt="Pretelio products management screen" loading="lazy" decoding="async" widths={[720, 1080, 1440]} sizes="(max-width: 78rem) 100vw, 78rem" />
				</div>
			</section>

			<section class="editorial-section" id="pricing">
				<div class="section-rail">
					<p class="section-kicker">Pricing System</p>
				</div>
				<div class="story-block">
					<p>A flexible rule-based pricing system:</p>
					<ul class="outcome-list">
						{pricingFeatures.map((item) => <li>{item}</li>)}
					</ul>
					<Image class="single-image" src={pricingImage} alt="Pretelio pricing system screen" loading="lazy" decoding="async" widths={[720, 1080, 1440]} sizes="(max-width: 78rem) 100vw, 78rem" />
				</div>
			</section>

			<section class="editorial-section" id="stores">
				<div class="section-rail">
					<p class="section-kicker">Stores Management</p>
				</div>
				<div class="story-block">
					<p>Store-level operations and distribution:</p>
					<ul class="outcome-list">
						{storesFeatures.map((item) => <li>{item}</li>)}
					</ul>
					<Image class="single-image" src={storesImage} alt="Pretelio stores management screen" loading="lazy" decoding="async" widths={[720, 1080, 1440]} sizes="(max-width: 78rem) 100vw, 78rem" />
				</div>
			</section>
		</main>
	</div>
</Layout>

<style>
	.case-page {
		position: relative;
		width: min(calc(100% - 3rem), 78rem);
		margin: 0 auto;
		padding: 1.25rem 0 5rem;
	}

	.eyebrow,
	.meta-label,
	.section-kicker {
		font-family: var(--font-mono);
		font-size: 0.82rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		line-height: 1.4;
		text-transform: uppercase;
	}

	.eyebrow a {
		display: inline-flex;
		align-items: center;
		padding: 0.1rem 0;
		color: var(--foreground);
		text-decoration: none;
		transition: opacity 120ms ease;
	}

	.eyebrow a:hover,
	.eyebrow a:focus-visible {
		opacity: 0.68;
	}

	.case-hero {
		padding: 6rem 0 4rem;
	}

	.eyebrow,
	.meta-label,
	.section-kicker {
		margin: 0;
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.55rem;
		margin-bottom: 1.1rem;
		color: var(--muted-foreground);
		font-style: normal;
	}

	.breadcrumb-link {
		font-weight: 600;
	}

	.breadcrumb-separator {
		color: var(--muted-foreground);
	}

	h1,
	h2 {
		margin: 0;
		font-weight: 800;
		letter-spacing: -0.05em;
		color: var(--foreground);
	}

	.hero-subgrid {
		display: grid;
		grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.7fr);
		gap: 2rem;
		margin-top: 1.75rem;
	}

	.hero-text,
	.summary-main p,
	.story-block p,
	.outcome-list li,
	.closing-text {
		font-size: 1.08rem;
		line-height: 1.7;
	}

	.hero-text,
	.summary-main p,
	.story-block p,
	.closing-text {
		margin: 0;
	}

	.closing-text {
		color: var(--muted-foreground);
	}

	.meta-strip {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 2rem;
		padding: 1.5rem 0 0.5rem;
		border-top: 1px solid var(--border);
	}

	.meta-item {
		padding-top: 0.75rem;
	}

	.meta-value {
		margin: 0.35rem 0 0;
		font-size: 1.15rem;
		font-weight: 700;
	}

	.lead-image-section {
		padding: 2rem 0 4rem;
	}

	.lead-image {
		width: 100%;
		max-width: 46rem;
		margin: 0 auto;
		display: block;
		border: 1px solid var(--border);
		border-radius: 1.5rem;
		box-shadow: var(--shadow-large);
	}

	.single-image,
	.gallery-image {
		width: 100%;
		border: 1px solid var(--border);
		border-radius: 1.5rem;
		box-shadow: var(--shadow-large);
	}

	.single-image {
		margin-top: 0.5rem;
	}

	.summary-section {
		padding: 0 0 3rem;
		border-bottom: 1px solid var(--border);
	}

	.summary-section h2 {
		margin-top: 0.75rem;
		font-size: clamp(2rem, 3vw, 3rem);
		line-height: 1.04;
	}

	.summary-main {
		display: grid;
		gap: 1rem;
		margin-top: 1.5rem;
	}

	.editorial-section {
		display: grid;
		grid-template-columns: 16rem minmax(0, 1fr);
		gap: 2rem;
		padding: 2.5rem 0;
		border-bottom: 1px solid var(--border);
	}

	#stores {
		border-bottom: 0;
	}

	.editorial-section-no-divider {
		border-bottom: 0;
		padding-bottom: 0;
	}

	.section-rail {
		align-self: start;
	}

	.story-block {
		display: grid;
		gap: 1rem;
		max-width: 52rem;
		margin-top: 0;
	}

	.outcome-list {
		margin: 0;
		padding-left: 1.25rem;
		list-style: disc;
		display: grid;
		gap: 0.4rem;
	}

	.outcome-list li::marker {
		color: var(--foreground);
	}

	@media (max-width: 980px) {
		.hero-subgrid,
		.meta-strip {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 720px) {
		.case-page {
			width: min(calc(100% - 2.5rem), 78rem);
			padding-top: 1rem;
		}

		.editorial-section {
			grid-template-columns: 1fr;
		}

		.case-hero {
			padding: 4rem 0 3rem;
		}

		.hero-text,
		.summary-main p,
		.story-block p,
		.outcome-list li,
		.closing-text {
			font-size: 1.05rem;
		}
	}
</style>
