---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import portraitImage from '../assets/images/hassan-portrait.png';
---

<Layout
	title="About Hassan Mujtaba | Product Designer & UX Architect"
	description="About Hassan Mujtaba, a Product Designer & UX Architect focused on AI-enabled, data-driven SaaS platforms and complex enterprise systems."
>
	<a class="skip-link" href="#main-content">Skip to content</a>

	<div class="page">
		<SiteHeader />

		<main id="main-content">
			<section class="hero">
				<p class="eyebrow">About</p>
				<div class="hero-layout">
					<div class="hero-copy">
						<h1 class="display-title">I design complex systems by aligning user goals, business strategy, and system logic.</h1>
						<p class="hero-text">
							I'm Hassan, a Product Designer & UX Architect with 12+ years turning dense,
							multi-module SaaS products into experiences people navigate with confidence.
						</p>
					</div>
					<div class="hero-portrait-wrap">
						<Image
							class="hero-portrait"
							src={portraitImage}
							alt="Portrait of Muhammad Hassan Mujtaba"
							loading="eager"
							decoding="async"
							widths={[320, 480, 640]}
							sizes="(max-width: 980px) 100vw, 32vw"
						/>
					</div>
				</div>
			</section>

			<section class="editorial-section">
				<div class="section-rail">
					<p class="section-kicker">Background</p>
				</div>
				<div class="story-block">
					<p>
						12+ years structuring multi-module SaaS systems that scale with operational
						complexity, without losing usability under real-world pressure.
					</p>
					<ul class="tag-list">
						<li>Enterprise Intelligence</li>
						<li>Renewable Energy ERP</li>
						<li>Healthcare Platforms</li>
					</ul>
				</div>
			</section>

			<section class="editorial-section">
				<div class="section-rail">
					<p class="section-kicker">How I Work</p>
				</div>
				<div class="story-block">
					<p>AI woven through every stage, not bolted on at the end:</p>
					<ul class="tag-list">
						<li>Understand</li>
						<li>Research</li>
						<li>Architect</li>
						<li>Design</li>
						<li>Validate</li>
						<li>Deliver</li>
					</ul>
				</div>
			</section>

			<section class="editorial-section">
				<div class="section-rail">
					<p class="section-kicker">Focus</p>
				</div>
				<div class="story-block">
					<ul class="focus-list">
						<li><strong>AI-integrated product systems</strong> — intelligent workflows for enterprise decision-making</li>
						<li><strong>Business-aligned architecture</strong> — multi-module SaaS systems that scale</li>
						<li><strong>Cross-functional influence</strong> — constraints turned into structured interaction models</li>
					</ul>
				</div>
			</section>
		</main>
	</div>
</Layout>

<style>
	.page {
		position: relative;
		width: min(calc(100% - 3rem), 78rem);
		margin: 0 auto;
		padding: 1.25rem 0 5rem;
	}

	.eyebrow,
	.section-kicker {
		font-family: var(--font-mono);
		font-size: 0.82rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		line-height: 1.4;
		text-transform: uppercase;
	}

	.hero {
		padding: 6rem 0 4rem;
	}

	.hero-layout {
		display: grid;
		grid-template-columns: minmax(0, 1.35fr) minmax(15rem, 20rem);
		gap: 2.5rem;
		align-items: start;
		margin-top: 1rem;
	}

	.hero-copy {
		max-width: 52rem;
	}

	.eyebrow,
	.section-kicker {
		margin: 0;
		color: var(--muted-foreground);
		font-style: normal;
	}

	.hero-text,
	.story-block p {
		font-size: 1.08rem;
		line-height: 1.7;
		margin: 0;
	}

	.hero-text {
		max-width: 44rem;
		margin-top: 1.5rem;
	}

	.hero-portrait-wrap {
		display: flex;
		justify-content: flex-end;
		align-self: start;
		padding-top: 0.35rem;
	}

	.hero-portrait {
		width: min(100%, 20rem);
		height: auto;
		display: block;
		border-radius: 1.5rem;
		box-shadow: 0 18px 40px rgba(23, 23, 23, 0.08);
	}

	.editorial-section {
		display: grid;
		grid-template-columns: 16rem minmax(0, 1fr);
		gap: 2rem;
		padding: 2.5rem 0;
		border-top: 1px solid var(--border);
	}

	.section-rail {
		align-self: start;
	}

	.story-block {
		display: grid;
		gap: 1rem;
		max-width: 52rem;
	}

	.tag-list {
		margin: 0;
		padding: 0;
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
	}

	.tag-list li {
		padding: 0.45rem 0.9rem;
		border: 1px solid var(--border);
		border-radius: 999px;
		font-size: 0.92rem;
		font-weight: 600;
		color: var(--foreground);
	}

	.focus-list {
		margin: 0;
		padding-left: 1.25rem;
		list-style: disc;
		display: grid;
		gap: 0.65rem;
	}

	.focus-list li {
		font-size: 1.08rem;
		line-height: 1.6;
	}

	.focus-list strong {
		color: var(--foreground);
	}

	@media (max-width: 1100px) {
		.hero-layout {
			grid-template-columns: 1fr;
			gap: 1.75rem;
			align-items: start;
		}

		.hero-copy {
			max-width: 100%;
		}

		.hero-text {
			max-width: 42rem;
		}

		.hero-portrait-wrap {
			justify-content: flex-start;
			padding-top: 0;
		}
	}

	@media (max-width: 720px) {
		.page {
			width: min(calc(100% - 1.5rem), 78rem);
			padding-top: 1rem;
		}

		.hero {
			padding: 4rem 0 3rem;
		}

		.editorial-section {
			grid-template-columns: 1fr;
		}

		.hero-text,
		.story-block p {
			font-size: 1.05rem;
		}

		.hero-portrait {
			width: min(100%, 16rem);
		}
	}
</style>
