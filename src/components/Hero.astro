---
import { Image } from 'astro:assets';
import heroPhoto from '../assets/images/hero/mine-hero.png';
---

<section class="hero-accent" id="top">
	<div class="hero-accent-inner">
		<div class="hero-accent-copy">
			<div class="hero-pill-row">
				<a class="hero-pill" href="/resume">
					12+ Years of Enterprise Product Design
					<span class="hero-pill-divider">
						<span class="hero-pill-link">Resume</span>
						<svg
							class="hero-pill-chevron"
							width="16"
							height="16"
							viewBox="0 0 16 16"
							fill="none"
							xmlns="http://www.w3.org/2000/svg"
						>
							<path
								d="M6 4L10 8L6 12"
								stroke="currentColor"
								stroke-width="1.5"
								stroke-linecap="round"
								stroke-linejoin="round"
							/>
						</svg>
					</span>
				</a>
			</div>

			<div class="hero-accent-title-wrap">
				<h1 class="hero-accent-title">
					I design complex enterprise software built for clarity at scale.
				</h1>
			</div>

			<div class="hero-accent-text-wrap">
				<p class="hero-accent-text">
					Seasoned in designing AI-enabled SaaS platforms and enterprise systems - where clarity
					and decision-making matter more than surface aesthetics.
				</p>
			</div>

			<div class="hero-accent-actions">
				<a class="hero-cta" href="/work">
					View My Work
					<svg
						class="hero-cta-chevron"
						width="16"
						height="16"
						viewBox="0 0 16 16"
						fill="none"
						xmlns="http://www.w3.org/2000/svg"
					>
						<path
							d="M6 4L10 8L6 12"
							stroke="currentColor"
							stroke-width="1.5"
							stroke-linecap="round"
							stroke-linejoin="round"
						/>
					</svg>
				</a>
			</div>
		</div>

		<div class="hero-accent-media">
			<Image class="hero-accent-photo" src={heroPhoto} alt="Hassan Mujtaba" width={679} height={795} priority />
		</div>
	</div>
</section>

<style>
	.hero-accent {
		position: relative;
		overflow: hidden;
		padding: 6rem 0 4rem;
	}

	.hero-accent::before {
		content: '';
		position: absolute;
		top: 0;
		left: 50%;
		width: 100%;
		height: 100%;
		transform: translateX(-50%);
		background-image: url('/images/hero/squared-bg-element.svg');
		background-repeat: no-repeat;
		background-position: center center;
		background-size: cover;
		z-index: -1;
	}

	:root[data-theme='dark'] .hero-accent::before {
		background-image: url('/images/hero/squared-bg-element-dark.svg');
	}

	.hero-accent-inner {
		display: flex;
		align-items: center;
		gap: 3rem;
	}

	.hero-accent-copy {
		flex: 1 1 55%;
		min-width: 0;
	}

	.hero-pill-row {
		display: flex;
		justify-content: flex-start;
	}

	.hero-pill {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.5rem 0.75rem;
		background: #eef1fc;
		border: 1px solid var(--border);
		border-radius: 999px;
		font-size: 0.8rem;
		font-weight: 500;
		color: var(--foreground);
		text-decoration: none;
		transition: background-color 140ms ease;
	}

	:root[data-theme='dark'] .hero-pill {
		background: var(--card);
	}

	.hero-pill:hover,
	.hero-pill:focus-visible {
		background: #e2e7f9;
	}

	:root[data-theme='dark'] .hero-pill:hover,
	:root[data-theme='dark'] .hero-pill:focus-visible {
		background: #29384d;
	}

	.hero-pill-divider {
		display: inline-flex;
		align-items: center;
		gap: 0.15rem;
		padding-left: 0.5rem;
		border-left: 1px solid var(--border);
		color: var(--accent-link);
		font-weight: 600;
	}

	.hero-pill-chevron {
		flex-shrink: 0;
	}

	.hero-accent-title-wrap {
		max-width: 34rem;
		margin: 1.5rem 0 0;
		text-align: left;
	}

	.hero-accent-title {
		margin: 0;
		font-size: clamp(2.25rem, 4vw, 3.5rem);
		font-weight: 800;
		line-height: 1.05;
		letter-spacing: -0.04em;
		color: var(--foreground);
	}

	.hero-accent-text-wrap {
		max-width: 32rem;
		margin: 1.5rem 0 0;
		text-align: left;
	}

	.hero-accent-text {
		margin: 0;
		font-size: 1.2rem;
		line-height: 1.55;
		color: var(--muted-foreground);
	}

	.hero-accent-actions {
		display: flex;
		justify-content: flex-start;
		gap: 0.75rem;
		margin-top: 2rem;
	}

	.hero-cta {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.85rem 1.5rem;
		background: var(--foreground);
		color: var(--background);
		border-radius: 999px;
		font-size: 0.95rem;
		font-weight: 600;
		text-decoration: none;
		transition:
			transform 140ms ease,
			box-shadow 140ms ease;
	}

	.hero-cta:hover,
	.hero-cta:focus-visible {
		transform: translateY(-2px);
		box-shadow: var(--shadow-medium);
	}

	.hero-cta-chevron {
		flex-shrink: 0;
	}

	.hero-accent-media {
		flex: 1 1 45%;
		display: flex;
		justify-content: center;
		align-items: center;
	}

	.hero-accent-photo {
		width: 100%;
		max-width: 24rem;
		height: auto;
	}

	@media (max-width: 640px) {
		.hero-accent-inner {
			flex-direction: column-reverse;
			gap: 2rem;
		}

		.hero-accent-copy,
		.hero-accent-media {
			flex: 1 1 auto;
			width: 100%;
		}

		.hero-accent-media {
			max-width: 18rem;
			margin: 0 auto;
		}
	}

	@media (max-width: 720px) {
		.hero-accent {
			padding: 4rem 0 3rem;
		}

		.hero-pill {
			font-size: 0.72rem;
		}

		.hero-accent-text {
			font-size: 1.05rem;
		}
	}
</style>
