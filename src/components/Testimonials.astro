---
import { Image } from 'astro:assets';
import { testimonials } from '../data/testimonials';

const stats = [
	{ label: 'Years of experience', value: '12+', sub: 'across enterprise SaaS & AI systems' },
	{ label: 'Products shipped', value: '10', sub: 'live case studies on this site' },
	{ label: 'Client testimonials', value: '9', sub: 'from founders & teammates' },
];

const initials = (name: string) =>
	name
		.split(' ')
		.map((part) => part[0])
		.join('')
		.slice(0, 2)
		.toUpperCase();

const track = [...testimonials, ...testimonials];
---

<section class="testimonials" id="testimonials">
	<div class="testimonials-header">
		<h2 class="testimonials-title">Loved by the teams and founders I've worked with</h2>
	</div>

	<div class="testimonials-marquee">
		<div class="testimonials-marquee-fade testimonials-marquee-fade--left" aria-hidden="true"></div>
		<div class="testimonials-marquee-fade testimonials-marquee-fade--right" aria-hidden="true"></div>

		<div class="testimonials-track">
			{
				track.map((testimonial) => (
					<div class="testimonial-card">
						<div class="testimonial-quote-wrap">
							<p class="testimonial-quote">" {testimonial.quote} "</p>
						</div>
						<div class="testimonial-footer">
							{testimonial.avatar ? (
								<Image
									class="testimonial-avatar-photo"
									src={testimonial.avatar}
									alt={testimonial.name}
									width={46}
									height={46}
								/>
							) : (
								<div class="testimonial-avatar" aria-hidden="true">
									{initials(testimonial.name)}
								</div>
							)}
							<div>
								<p class="testimonial-name">{testimonial.name}</p>
								<p class="testimonial-company">{testimonial.company}</p>
							</div>
						</div>
					</div>
				))
			}
		</div>
	</div>

	<div class="testimonials-stats">
		{
			stats.map((stat) => (
				<div class="stat">
					<h3 class="stat-label">{stat.label}</h3>
					<p class="stat-value">{stat.value}</p>
					<p class="stat-sub">{stat.sub}</p>
				</div>
			))
		}
	</div>
</section>

<style>
	.testimonials {
		padding: 3rem 0 6rem;
	}

	.testimonials-header {
		max-width: 34rem;
		margin: 0 0 2.5rem;
	}

	.testimonials-title {
		margin: 0;
		font-size: clamp(1.75rem, 2.6vw, 2.35rem);
		font-weight: 700;
		line-height: 1.15;
		letter-spacing: -0.03em;
		color: var(--foreground);
	}

	.testimonials-marquee {
		position: relative;
		overflow: hidden;
		width: 100vw;
		left: 50%;
		right: 50%;
		margin-left: -50vw;
		margin-right: -50vw;
	}

	.testimonials-marquee-fade {
		position: absolute;
		top: 0;
		bottom: 0;
		width: 5rem;
		z-index: 2;
		pointer-events: none;
	}

	.testimonials-marquee-fade--left {
		left: 0;
		background: linear-gradient(to right, var(--background), transparent);
	}

	.testimonials-marquee-fade--right {
		right: 0;
		background: linear-gradient(to left, var(--background), transparent);
	}

	.testimonials-track {
		display: flex;
		align-items: stretch;
		gap: 1.5rem;
		width: max-content;
		animation: testimonials-scroll 55s linear infinite;
	}

	.testimonials-marquee:hover .testimonials-track {
		animation-play-state: paused;
	}

	.testimonial-card {
		display: flex;
		flex-direction: column;
		flex-shrink: 0;
		width: 21rem;
		min-height: 16.5rem;
		background: var(--muted);
		border: 1px solid var(--border);
		border-radius: 1rem;
		overflow: hidden;
	}

	:root[data-theme='dark'] .testimonial-card {
		background: var(--card);
	}

	.testimonial-quote-wrap {
		flex: 1;
		padding: 1.25rem 1.5rem;
	}

	.testimonial-quote {
		margin: 0;
		font-size: 1rem;
		font-style: italic;
		line-height: 1.55;
		color: var(--card-foreground);
	}

	.testimonial-footer {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 1rem 1.5rem;
		background: var(--background);
	}

	.testimonial-avatar {
		flex-shrink: 0;
		display: grid;
		place-items: center;
		width: 2.875rem;
		height: 2.875rem;
		border-radius: 50%;
		background: var(--border);
		color: var(--card-foreground);
		font-size: 0.85rem;
		font-weight: 700;
	}

	.testimonial-avatar-photo {
		flex-shrink: 0;
		width: 2.875rem;
		height: 2.875rem;
		border-radius: 50%;
		object-fit: cover;
	}

	.testimonial-name {
		margin: 0;
		font-size: 0.95rem;
		font-weight: 700;
		letter-spacing: -0.01em;
		color: var(--card-foreground);
	}

	.testimonial-company {
		margin: 0.1rem 0 0;
		font-size: 0.8rem;
		color: var(--muted-foreground);
	}

	.testimonials-stats {
		margin-top: clamp(2.5rem, 4vw, 5rem);
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 2rem;
	}

	.stat-label {
		margin: 0;
		font-size: 1.15rem;
		font-weight: 600;
		color: var(--foreground);
	}

	.stat-value {
		margin: 0.5rem 0 0;
		font-size: clamp(2.5rem, 4.5vw, 3.75rem);
		font-weight: 700;
		letter-spacing: -0.02em;
		color: var(--accent-link);
	}

	.stat-sub {
		margin: 0.25rem 0 0;
		font-size: 0.95rem;
		color: var(--muted-foreground);
	}

	@keyframes testimonials-scroll {
		from {
			transform: translateX(0);
		}
		to {
			transform: translateX(-50%);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.testimonials-track {
			animation: none;
		}
	}

	@media (max-width: 720px) {
		.testimonials {
			padding: 2rem 0 4rem;
		}

		.testimonial-card {
			width: 17rem;
			min-height: 0;
		}

		.testimonials-marquee-fade {
			width: 2.5rem;
		}

		.testimonials-stats {
			grid-template-columns: 1fr;
			gap: 1.75rem;
		}
	}
</style>
