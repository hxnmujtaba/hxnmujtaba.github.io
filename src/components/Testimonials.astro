---
import { testimonials } from '../data/testimonials';

const stats = [
	{ label: 'Years of experience', value: '12+', sub: 'across enterprise SaaS & AI systems' },
	{ label: 'Products shipped', value: '10', sub: 'live case studies on this site' },
	{ label: 'Client testimonials', value: '6', sub: 'from founders & teammates' },
];

const initials = (name: string) =>
	name
		.split(' ')
		.map((part) => part[0])
		.join('')
		.slice(0, 2)
		.toUpperCase();
---

<section class="testimonials" id="testimonials">
	<div class="testimonials-panel">
		<div class="testimonials-header">
			<h2 class="testimonials-title">Loved by the teams and founders I've worked with</h2>
		</div>

		<div class="testimonials-grid">
			{
				testimonials.map((testimonial) => (
					<div class="testimonial-card">
						<div class="testimonial-quote-wrap">
							<p class="testimonial-quote">" {testimonial.quote} "</p>
						</div>
						<div class="testimonial-footer">
							<div class="testimonial-avatar" aria-hidden="true">
								{initials(testimonial.name)}
							</div>
							<div>
								<p class="testimonial-name">{testimonial.name}</p>
								<p class="testimonial-company">{testimonial.company}</p>
							</div>
						</div>
					</div>
				))
			}
		</div>

		<div class="testimonials-stats">
			{
				stats.map((stat) => (
					<div class="stat">
						<h3 class="stat-label">{stat.label}</h3>
						<p class="stat-value">{stat.value}</p>
						<p class="stat-sub">{stat.sub}</p>
					</div>
				))
			}
		</div>
	</div>
</section>

<style>
	.testimonials {
		padding: 3rem 0 6rem;
	}

	.testimonials-panel {
		background: #0f172a;
		border-radius: 1.35rem;
		padding: clamp(1.75rem, 3vw, 3.5rem);
		overflow: hidden;
	}

	.testimonials-header {
		max-width: 34rem;
		margin: 0 0 2.5rem;
	}

	.testimonials-title {
		margin: 0;
		font-size: clamp(1.75rem, 2.6vw, 2.35rem);
		font-weight: 700;
		line-height: 1.15;
		letter-spacing: -0.03em;
		color: #f5f7fb;
	}

	.testimonials-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1.5rem;
	}

	.testimonial-card {
		display: flex;
		flex-direction: column;
		height: 100%;
		background: #ffffff;
		border-radius: 1rem;
		overflow: hidden;
	}

	.testimonial-quote-wrap {
		flex: 1;
		padding: 1.25rem 1.5rem;
	}

	.testimonial-quote {
		margin: 0;
		font-size: 1rem;
		font-style: italic;
		line-height: 1.55;
		color: #171717;
	}

	.testimonial-footer {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 1rem 1.5rem;
		background: #f5f5f5;
	}

	.testimonial-avatar {
		flex-shrink: 0;
		display: grid;
		place-items: center;
		width: 2.875rem;
		height: 2.875rem;
		border-radius: 50%;
		background: #dbe2ea;
		color: #171717;
		font-size: 0.85rem;
		font-weight: 700;
	}

	.testimonial-name {
		margin: 0;
		font-size: 0.95rem;
		font-weight: 700;
		letter-spacing: -0.01em;
		color: #171717;
	}

	.testimonial-company {
		margin: 0.1rem 0 0;
		font-size: 0.8rem;
		color: #676767;
	}

	.testimonials-stats {
		margin-top: clamp(2.5rem, 4vw, 5rem);
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 2rem;
	}

	.stat-label {
		margin: 0;
		font-size: 1.15rem;
		font-weight: 600;
		color: #ffffff;
	}

	.stat-value {
		margin: 0.5rem 0 0;
		font-size: clamp(2.5rem, 4.5vw, 3.75rem);
		font-weight: 700;
		letter-spacing: -0.02em;
		color: #3b82f6;
	}

	.stat-sub {
		margin: 0.25rem 0 0;
		font-size: 0.95rem;
		color: #a3acb9;
	}

	@media (max-width: 980px) {
		.testimonials-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 720px) {
		.testimonials {
			padding: 2rem 0 4rem;
		}

		.testimonials-grid {
			grid-template-columns: 1fr;
		}

		.testimonials-stats {
			grid-template-columns: 1fr;
			gap: 1.75rem;
		}
	}
</style>
