---
import { testimonials } from '../data/testimonials';

const stats = [
	{ value: '12+', label: 'Years of experience' },
	{ value: '10', label: 'Enterprise products shipped' },
	{ value: '6', label: 'Client & founder testimonials' },
];

const initials = (name: string) =>
	name
		.split(' ')
		.map((part) => part[0])
		.join('')
		.slice(0, 2)
		.toUpperCase();
---

<section class="testimonials" id="testimonials">
	<div class="testimonials-header">
		<p class="eyebrow">Testimonials</p>
		<h2 class="testimonials-title">What people I've worked with say</h2>
	</div>

	<div class="testimonials-grid">
		{
			testimonials.map((testimonial) => (
				<div class="testimonial-card">
					<p class="testimonial-quote">"{testimonial.quote}"</p>
					<div class="testimonial-footer">
						<div class="testimonial-avatar" aria-hidden="true">
							{initials(testimonial.name)}
						</div>
						<div>
							<p class="testimonial-name">{testimonial.name}</p>
							<p class="testimonial-company">{testimonial.company}</p>
						</div>
					</div>
				</div>
			))
		}
	</div>

	<div class="testimonials-stats">
		{
			stats.map((stat) => (
				<div class="stat">
					<p class="stat-value">{stat.value}</p>
					<p class="stat-label">{stat.label}</p>
				</div>
			))
		}
	</div>
</section>

<style>
	.testimonials {
		padding: 5rem 0 6rem;
	}

	.testimonials-header {
		max-width: 42rem;
		margin: 0 auto 2.75rem;
		text-align: center;
	}

	.testimonials-title {
		margin: 0.5rem 0 0;
		font-size: clamp(1.85rem, 2.4vw, 2.35rem);
	}

	.testimonials-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1.5rem;
	}

	.testimonial-card {
		display: flex;
		flex-direction: column;
		height: 100%;
		padding: 1.5rem;
		background: var(--card);
		border: 1px solid var(--border);
		border-radius: 1.25rem;
		box-shadow: var(--shadow-soft);
	}

	.testimonial-quote {
		flex: 1;
		margin: 0 0 1.5rem;
		font-size: 1rem;
		line-height: 1.6;
		color: var(--foreground);
	}

	.testimonial-footer {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding-top: 1.25rem;
		border-top: 1px solid var(--border);
	}

	.testimonial-avatar {
		flex-shrink: 0;
		display: grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		border-radius: 50%;
		background: var(--muted);
		color: var(--foreground);
		font-family: var(--font-mono);
		font-size: 0.85rem;
		font-weight: 700;
	}

	.testimonial-name {
		margin: 0;
		font-size: 0.95rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		color: var(--foreground);
	}

	.testimonial-company {
		margin: 0.15rem 0 0;
		font-size: 0.85rem;
		color: var(--muted-foreground);
	}

	.testimonials-stats {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 2rem;
		margin-top: 3.5rem;
		padding-top: 3rem;
		border-top: 1px solid var(--border);
		text-align: center;
	}

	.stat-value {
		margin: 0;
		font-size: clamp(2.25rem, 4vw, 3.25rem);
		font-weight: 800;
		letter-spacing: -0.04em;
		color: var(--accent-link);
	}

	.stat-label {
		margin: 0.4rem 0 0;
		font-size: 0.95rem;
		color: var(--muted-foreground);
	}

	@media (max-width: 980px) {
		.testimonials-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 720px) {
		.testimonials {
			padding: 3.5rem 0 4rem;
		}

		.testimonials-grid {
			grid-template-columns: 1fr;
		}

		.testimonials-stats {
			grid-template-columns: 1fr;
			gap: 1.75rem;
			margin-top: 2.5rem;
			padding-top: 2rem;
		}
	}
</style>
